{
  "name": "ctrlyoke",
  "displayName": "ctrlyoke",
  "description": "Run multi-step AI coding workflows across 6 harnesses (Copilot CLI, Claude, Codex, Antigravity, Qwen, OpenCode) with sequential execution, end-condition validation, and a live dashboard.",
  "version": "0.1.0",
  "publisher": "fuzzynova",
  "license": "SEE LICENSE IN LICENSE.md",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/FuzzyNova/ctrlyoke"
  },
  "homepage": "https://ctrlyoke.dev",
  "bugs": {
    "url": "https://github.com/FuzzyNova/ctrlyoke/issues"
  },
  "engines": {
    "vscode": "^1.104.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "AI",
    "automation",
    "copilot",
    "claude",
    "codex",
    "antigravity",
    "workflow",
    "prompt",
    "agent",
    "LLM"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.ctrlyoke.yaml",
    "workspaceContains:**/*.ctrlyoke.yml",
    "workspaceContains:**/*.ctrlyoke.json",
    "workspaceContains:**/*.prompt.md"
  ],
  "main": "./out/extension.js",
  "bin": {
    "ctrlyoke-mcp": "./out/mcp-server.js",
    "ctrlyoke": "./out/cli.js"
  },
  "contributes": {
    "configuration": {
      "title": "ctrlyoke",
      "properties": {
        "ctrlyoke.workspaceDirectory": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Directory that contains the `.ctrlyoke` folder for this workspace. Leave empty to auto-detect: the folder of the `.code-workspace` file when one is open, otherwise the first workspace folder. Accepts an absolute path or a path relative to the workspace file. Supports `${workspaceFolder}` and `${workspaceFolder:Name}`."
        },
        "ctrlyoke.permissions.antigravityStatusLineTracking": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Enable Antigravity statusline token/context tracking. This writes to the GLOBAL `~/.gemini/antigravity-cli/settings.json` and wraps any statusline command you already have configured, forwarding its output unchanged. Disable this if you do not want ctrlyoke to touch that global file or your existing statusline is fragile."
        },
        "ctrlyoke.usageTracking.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Enable workspace-local provider quota and observed-usage tracking. Claude statusline capture is automatic for ctrlyoke-started sessions while this setting is enabled."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "ctrlyoke.workflowMcpProvider",
        "label": "ctrlyoke Workflow MCPs"
      }
    ],
    "commands": [
      {
        "command": "ctrlyoke.openPanel",
        "title": "Open ctrlyoke Panel",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.refreshHarnessUsage",
        "title": "ctrlyoke: Refresh Harness Usage",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.showGettingStarted",
        "title": "Show Getting Started",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.pause",
        "title": "Pause Execution",
        "category": "ctrlyoke",
        "icon": "$(debug-pause)"
      },
      {
        "command": "ctrlyoke.resume",
        "title": "Resume Execution",
        "category": "ctrlyoke",
        "icon": "$(debug-continue)"
      },
      {
        "command": "ctrlyoke.stop",
        "title": "Stop Execution",
        "category": "ctrlyoke",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ctrlyoke.devMenu",
        "title": "Developer Tools",
        "category": "ctrlyoke",
        "icon": "$(beaker)"
      },
      {
        "command": "ctrlyoke.createEndConditionScript",
        "title": "Create End Condition Script",
        "category": "ctrlyoke",
        "icon": "$(new-file)"
      },
      {
        "command": "ctrlyoke.importWorkflowTemplates",
        "title": "Import Workflow Templates",
        "category": "ctrlyoke",
        "icon": "$(file-code)"
      },
      {
        "command": "ctrlyoke.newWorkflow",
        "title": "New Workflow from Template",
        "category": "ctrlyoke",
        "icon": "$(new-file)"
      },
      {
        "command": "ctrlyoke.createNewTemplate",
        "title": "Create New Custom Template",
        "category": "ctrlyoke",
        "icon": "$(file-add)"
      },
      {
        "command": "ctrlyoke.runFromContext",
        "title": "Run with ctrlyoke",
        "category": "ctrlyoke",
        "icon": "$(send)"
      },
      {
        "command": "ctrlyoke.loadFromContext",
        "title": "Load in ctrlyoke",
        "category": "ctrlyoke",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "ctrlyoke.selectPromptFile",
        "title": "Select Prompt File",
        "category": "ctrlyoke",
        "icon": "$(file)"
      },
      {
        "command": "ctrlyoke.resumeSession",
        "title": "Resume Session",
        "category": "ctrlyoke",
        "icon": "$(history)"
      },
      {
        "command": "ctrlyoke.run",
        "title": "Run",
        "category": "ctrlyoke",
        "icon": "$(play)"
      },
      {
        "command": "ctrlyoke.showOutputPanel",
        "title": "Show Output Panel",
        "category": "ctrlyoke",
        "icon": "$(output)"
      },
      {
        "command": "ctrlyoke.queueFromContext",
        "title": "Queue with ctrlyoke",
        "category": "ctrlyoke",
        "icon": "$(add)"
      },
      {
        "command": "ctrlyoke.queueNextFromContext",
        "title": "Queue Next with ctrlyoke",
        "category": "ctrlyoke",
        "icon": "$(insert)"
      },
      {
        "command": "ctrlyoke.clearWorkflow",
        "title": "New Blank Workflow",
        "category": "ctrlyoke",
        "icon": "$(add)"
      },
      {
        "command": "ctrlyoke.appendFromDashboard",
        "title": "Queue Prompt File",
        "category": "ctrlyoke",
        "icon": "$(insert)"
      },
      {
        "command": "ctrlyoke.initWorkspace",
        "title": "Initialize Workspace",
        "category": "ctrlyoke",
        "icon": "$(folder-opened)"
      },
      {
        "command": "ctrlyoke.addFileToPromptEditor",
        "title": "Add File to ctrlyoke",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.addDirectoryToPromptEditor",
        "title": "Add Directory to ctrlyoke",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.addSelectionToPromptEditor",
        "title": "Add Selection to ctrlyoke",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.addSymbolToPromptEditor",
        "title": "Add Symbol to ctrlyoke",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.addScmResourcesToPromptEditor",
        "title": "Add File to ctrlyoke",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.addTimelineCommitToPromptEditor",
        "title": "Add Commit to ctrlyoke",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.searchHistory",
        "title": "Search ctrlyoke History",
        "category": "ctrlyoke",
        "icon": "$(search)"
      },
      {
        "command": "ctrlyoke.generateCommitMessage",
        "title": "Generate Commit Message with ctrlyoke",
        "category": "ctrlyoke",
        "icon": {
          "light": "images/ctrlyoke-icon-light.svg",
          "dark": "images/ctrlyoke-icon-dark.svg"
        }
      },
      {
        "command": "ctrlyoke.cancelCommitMessageGeneration",
        "title": "Cancel Commit Message Generation",
        "category": "ctrlyoke",
        "icon": "$(stop-circle)"
      }
    ],
    "keybindings": [
      {
        "command": "ctrlyoke.clearWorkflow",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "focusedView == 'ctrlyoke.dashboard'"
      },
      {
        "command": "ctrlyoke.newWorkflow",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "focusedView == 'ctrlyoke.dashboard'"
      },
      {
        "command": "ctrlyoke.selectPromptFile",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "focusedView == 'ctrlyoke.dashboard'"
      },
      {
        "command": "ctrlyoke.appendFromDashboard",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "when": "focusedView == 'ctrlyoke.dashboard'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ctrlyoke.openPanel"
        },
        {
          "command": "ctrlyoke.resumeSession"
        },
        {
          "command": "ctrlyoke.pause"
        },
        {
          "command": "ctrlyoke.resume"
        },
        {
          "command": "ctrlyoke.stop"
        },
        {
          "command": "ctrlyoke.devMenu",
          "when": "ctrlyoke.devMode"
        },
        {
          "command": "ctrlyoke.createEndConditionScript"
        },
        {
          "command": "ctrlyoke.importWorkflowTemplates"
        },
        {
          "command": "ctrlyoke.runFromContext",
          "when": "false"
        },
        {
          "command": "ctrlyoke.loadFromContext",
          "when": "false"
        },
        {
          "command": "ctrlyoke.queueFromContext",
          "when": "false"
        },
        {
          "command": "ctrlyoke.queueNextFromContext",
          "when": "false"
        },
        {
          "command": "ctrlyoke.addFileToPromptEditor",
          "when": "false"
        },
        {
          "command": "ctrlyoke.addDirectoryToPromptEditor",
          "when": "false"
        },
        {
          "command": "ctrlyoke.addSelectionToPromptEditor",
          "when": "false"
        },
        {
          "command": "ctrlyoke.addSymbolToPromptEditor",
          "when": "false"
        },
        {
          "command": "ctrlyoke.addScmResourcesToPromptEditor",
          "when": "false"
        },
        {
          "command": "ctrlyoke.addTimelineCommitToPromptEditor",
          "when": "false"
        },
        {
          "command": "ctrlyoke.generateCommitMessage",
          "when": "!ctrlyoke.generatingCommitMessage"
        },
        {
          "command": "ctrlyoke.cancelCommitMessageGeneration",
          "when": "ctrlyoke.generatingCommitMessage"
        }
      ],
      "explorer/context": [
        {
          "command": "ctrlyoke.runFromContext",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "ctrlyoke@1"
        },
        {
          "command": "ctrlyoke.loadFromContext",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "ctrlyoke@2"
        },
        {
          "command": "ctrlyoke.queueFromContext",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "ctrlyoke@3"
        },
        {
          "command": "ctrlyoke.queueNextFromContext",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "ctrlyoke@4"
        },
        {
          "command": "ctrlyoke.addFileToPromptEditor",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "ctrlyoke@5"
        },
        {
          "command": "ctrlyoke.addDirectoryToPromptEditor",
          "when": "explorerResourceIsFolder",
          "group": "ctrlyoke@5"
        }
      ],
      "editor/title": [
        {
          "command": "ctrlyoke.runFromContext",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "navigation"
        },
        {
          "command": "ctrlyoke.queueFromContext",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "navigation@2"
        },
        {
          "command": "ctrlyoke.queueNextFromContext",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "navigation@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "ctrlyoke.runFromContext",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "ctrlyoke@1"
        },
        {
          "command": "ctrlyoke.loadFromContext",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "ctrlyoke@2"
        },
        {
          "command": "ctrlyoke.queueFromContext",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "ctrlyoke@3"
        },
        {
          "command": "ctrlyoke.queueNextFromContext",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "ctrlyoke@4"
        },
        {
          "command": "ctrlyoke.addFileToPromptEditor",
          "when": "resourceScheme == file",
          "group": "ctrlyoke@5"
        }
      ],
      "editor/context": [
        {
          "command": "ctrlyoke.addSelectionToPromptEditor",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "2_ctrlyoke@1"
        },
        {
          "command": "ctrlyoke.addSymbolToPromptEditor",
          "when": "!editorHasSelection && resourceScheme == file",
          "group": "2_ctrlyoke@2"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "ctrlyoke.addSelectionToPromptEditor",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "2_ctrlyoke@1"
        },
        {
          "command": "ctrlyoke.addSymbolToPromptEditor",
          "when": "!editorHasSelection && resourceScheme == file",
          "group": "2_ctrlyoke@2"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "ctrlyoke.addScmResourcesToPromptEditor",
          "when": "scmProvider == git",
          "group": "2_ctrlyoke"
        }
      ],
      "scm/resourceFolder/context": [
        {
          "command": "ctrlyoke.addScmResourcesToPromptEditor",
          "when": "scmProvider == git",
          "group": "2_ctrlyoke"
        }
      ],
      "timeline/item/context": [
        {
          "command": "ctrlyoke.addTimelineCommitToPromptEditor",
          "when": "timelineItem =~ /git:file:commit\\b/",
          "group": "2_ctrlyoke"
        }
      ],
      "scm/title": [
        {
          "command": "ctrlyoke.generateCommitMessage",
          "when": "scmProvider == git && !ctrlyoke.generatingCommitMessage",
          "group": "navigation@-1"
        },
        {
          "command": "ctrlyoke.cancelCommitMessageGeneration",
          "when": "scmProvider == git && ctrlyoke.generatingCommitMessage",
          "group": "navigation@-1"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "ctrlyoke",
          "title": "ctrlyoke",
          "icon": "images/ctrlyoke-sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "ctrlyoke": [
        {
          "type": "webview",
          "id": "ctrlyoke.dashboard",
          "name": "ctrlyoke",
          "icon": "images/ctrlyoke-icon.svg"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "ctrlyoke.gettingStarted",
        "title": "Getting Started with ctrlyoke",
        "description": "Run your first AI coding workflow: verify a harness, create a workflow from a template, run it, and know where to get help.",
        "icon": "images/ctrlyoke-icon-simple-color.png",
        "steps": [
          {
            "id": "openPanel",
            "title": "Open the ctrlyoke panel",
            "description": "Everything happens in one panel: steps, live output, and settings.",
            "media": {
              "markdown": "walkthroughs/getting-started/open-panel.md"
            },
            "completionEvents": [
              "onView:ctrlyoke.dashboard"
            ]
          },
          {
            "id": "verifyHarness",
            "title": "Install and verify a harness CLI",
            "description": "ctrlyoke drives a CLI you install yourself — no CLI is bundled.",
            "media": {
              "markdown": "walkthroughs/getting-started/verify-harness.md"
            }
          },
          {
            "id": "createWorkflow",
            "title": "Create a workflow from a template",
            "description": "Templates build a multi-step workflow for you.",
            "media": {
              "markdown": "walkthroughs/getting-started/create-workflow.md"
            },
            "completionEvents": [
              "onCommand:ctrlyoke.newWorkflow"
            ]
          },
          {
            "id": "runWorkflow",
            "title": "Run it and read the output",
            "description": "Watch the harness work and step through the queue.",
            "media": {
              "markdown": "walkthroughs/getting-started/run-workflow.md"
            },
            "completionEvents": [
              "onCommand:ctrlyoke.run"
            ]
          },
          {
            "id": "getHelp",
            "title": "Get help when you're stuck",
            "description": "A built-in support agent and the docs are always available.",
            "media": {
              "markdown": "walkthroughs/getting-started/get-help.md"
            }
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "ctrlyoke_queue_status",
        "toolReferenceName": "ctrlyoke_queue_status",
        "displayName": "ctrlyoke Queue Status",
        "modelDescription": "Get comprehensive status of the current ctrlyoke workflow queue, including metadata and all prompts with their execution state",
        "canBeReferencedInPrompt": true,
        "tags": [
          "queue",
          "status",
          "workflow"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "ctrlyoke_append_queue",
        "toolReferenceName": "ctrlyoke_append_queue",
        "displayName": "ctrlyoke Append Queue",
        "modelDescription": "Append prompts to the current ctrlyoke workflow queue. Use when you want to extend the workflow with additional tasks. Supports inserting after current position ('next') or at end of queue ('end').",
        "canBeReferencedInPrompt": true,
        "tags": [
          "queue",
          "append",
          "workflow",
          "extend"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "description": "The prompt text to add to the queue"
                  },
                  "model": {
                    "type": "string",
                    "description": "Optional model override (e.g., 'claude-sonnet-4.5', 'gpt-5')"
                  }
                },
                "required": [
                  "prompt"
                ]
              },
              "description": "Array of prompts to add to the queue"
            },
            "position": {
              "type": "string",
              "enum": [
                "next",
                "end"
              ],
              "description": "Where to insert prompts: 'next' (after current) or 'end' (at end of queue)"
            },
            "source": {
              "type": "string",
              "description": "Source identifier (e.g., 'claude-cli', 'AI-generated tasks')"
            },
            "reason": {
              "type": "string",
              "description": "Optional explanation for why these prompts are being added"
            }
          },
          "required": [
            "prompts",
            "position"
          ]
        }
      },
      {
        "name": "ctrlyoke_capabilities",
        "toolReferenceName": "ctrlyoke_capabilities",
        "displayName": "ctrlyoke Capabilities",
        "modelDescription": "Get the available ctrlyoke harnesses and their supported models",
        "canBeReferencedInPrompt": true,
        "tags": [
          "harness",
          "model",
          "capabilities"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "ctrlyoke_read_output",
        "toolReferenceName": "ctrlyoke_read_output",
        "displayName": "ctrlyoke Read Output",
        "modelDescription": "Read AI response output from completed prompts in the ctrlyoke workflow queue",
        "canBeReferencedInPrompt": true,
        "tags": [
          "queue",
          "output",
          "workflow"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "indices": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "Array of prompt indices to read output for (0-based). Empty array returns all outputs."
            }
          }
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/*.ctrlyoke.json"
        ],
        "url": "./schemas/workflow-schema.json"
      },
      {
        "fileMatch": [
          "**/.ctrlyoke/settings.json"
        ],
        "url": "./schemas/settings-schema.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "**/*.ctrlyoke.yaml",
          "**/*.ctrlyoke.yml"
        ],
        "url": "./schemas/workflow-schema.yaml"
      }
    ]
  },
  "scripts": {
    "generate-schema": "node scripts/generate-yaml-schema.mjs",
    "generate-agent-files": "node scripts/generate-agent-files.mjs",
    "generate-sidebar-icon": "node scripts/generate-sidebar-icon.mjs",
    "generate-custom-icons": "node scripts/generate-custom-icons.mjs",
    "generate-app-icons": "node scripts/generate-app-icons.mjs",
    "generate-icons": "npm run generate-sidebar-icon && npm run generate-app-icons && npm run generate-custom-icons",
    "precompile": "npm run generate-schema && npm run generate-icons",
    "compile": "npm run compile:extension && npm run compile:webview",
    "compile:extension": "npm run typecheck:extension && node esbuild.js",
    "compile:webview": "npm run generate-custom-icons && npm run typecheck:webview && vite build --config src/ui/webview-react/vite.config.ts --mode development",
    "compile:webview:react-debug": "npm run generate-custom-icons && vite build --config src/ui/webview-react/vite.config.ts --mode react-debug",
    "compile:react-debug": "npm run compile:extension && npm run compile:webview:react-debug",
    "precompile-tests": "node scripts/clean-test-output.mjs",
    "compile-tests": "tsc -p .",
    "typecheck": "npm-run-all typecheck:extension typecheck:webview",
    "typecheck:extension": "tsc --noEmit",
    "typecheck:webview": "tsc --noEmit -p src/ui/webview-react/tsconfig.json",
    "watch": "npm-run-all -p watch:extension watch:webview",
    "watch:extension": "node esbuild.js --watch",
    "watch:webview": "npm run generate-custom-icons && vite build --watch --config src/ui/webview-react/vite.config.ts --mode development",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "dev:webview": "npm run generate-custom-icons && vite --config src/ui/webview-react/vite.config.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
