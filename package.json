{
  "name": "flightpath",
  "displayName": "FlightPath",
  "description": "Automate GitHub Copilot with structured prompt workflows",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.prompt.json",
    "workspaceContains:**/*.flightpath.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flightpath.takeOff",
        "title": "Take Off",
        "category": "FlightPath",
        "icon": "$(rocket)"
      },
      {
        "command": "flightpath.openPanel",
        "title": "Open FlightPath Panel",
        "category": "FlightPath"
      },
      {
        "command": "flightpath.createPromptFile",
        "title": "Create Prompt File",
        "category": "FlightPath"
      },
      {
        "command": "flightpath.pause",
        "title": "Pause Execution",
        "category": "FlightPath",
        "icon": "$(debug-pause)"
      },
      {
        "command": "flightpath.resume",
        "title": "Resume Execution",
        "category": "FlightPath",
        "icon": "$(debug-continue)"
      },
      {
        "command": "flightpath.stop",
        "title": "Stop Execution",
        "category": "FlightPath",
        "icon": "$(debug-stop)"
      },
      {
        "command": "flightpath.debugState",
        "title": "Show Debug State",
        "category": "FlightPath"
      },
      {
        "command": "flightpath.test.copilotAutomation",
        "title": "Test Copilot Chat Automation (POC)",
        "category": "FlightPath Test",
        "icon": "$(beaker)"
      },
      {
        "command": "flightpath.showCopilotStatus",
        "title": "Show Copilot Integration Status",
        "category": "FlightPath",
        "icon": "$(info)"
      },
      {
        "command": "flightpath.testAutomation",
        "title": "Test Automation",
        "category": "FlightPath",
        "icon": "$(pulse)"
      },
      {
        "command": "flightpath.retryCopilotDetection",
        "title": "Retry Copilot Detection",
        "category": "FlightPath",
        "icon": "$(refresh)"
      },
      {
        "command": "flightpath.listChatCommands",
        "title": "List All Chat Commands",
        "category": "FlightPath Test",
        "icon": "$(list-unordered)"
      },
      {
        "command": "flightpath.listAllCommands",
        "title": "List All VS Code Commands",
        "category": "FlightPath Test",
        "icon": "$(symbol-keyword)"
      },
      {
        "command": "flightpath.createEndConditionScript",
        "title": "Create End Condition Script",
        "category": "FlightPath",
        "icon": "$(new-file)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "flightpath.takeOff"
        },
        {
          "command": "flightpath.openPanel"
        },
        {
          "command": "flightpath.createPromptFile"
        },
        {
          "command": "flightpath.pause"
        },
        {
          "command": "flightpath.resume"
        },
        {
          "command": "flightpath.stop"
        },
        {
          "command": "flightpath.debugState"
        },
        {
          "command": "flightpath.test.copilotAutomation"
        },
        {
          "command": "flightpath.showCopilotStatus"
        },
        {
          "command": "flightpath.testAutomation"
        },
        {
          "command": "flightpath.retryCopilotDetection"
        },
        {
          "command": "flightpath.createEndConditionScript"
        }
      ],
      "explorer/context": [
        {
          "command": "flightpath.createPromptFile",
          "when": "explorerResourceIsFolder",
          "group": "2_workspace"
        }
      ]
    },
    "configuration": {
      "title": "FlightPath",
      "properties": {
        "flightpath.promptsDirectory": {
          "type": "string",
          "default": ".flightpath",
          "description": "Directory containing prompt files relative to workspace root"
        },
        "flightpath.scriptTimeout": {
          "type": "number",
          "default": 30000,
          "description": "Timeout for end condition scripts in milliseconds"
        },
        "flightpath.enableContextAwareness": {
          "type": "boolean",
          "default": true,
          "description": "Enable context-aware prompt generation"
        },
        "flightpath.chatWindowLocation": {
          "type": "string",
          "enum": [
            "chatPanel",
            "newTab",
            "newWindow"
          ],
          "enumDescriptions": [
            "Open Copilot Chat in the panel (recommended)",
            "Open Copilot Chat in an editor tab",
            "Open Copilot Chat in a new window"
          ],
          "default": "chatPanel",
          "description": "Choose where to open GitHub Copilot Chat for automation",
          "markdownDescription": "Choose where to open GitHub Copilot Chat for automation. **Chat Panel** is recommended for most users."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "**/*.prompt.json",
        "url": "./schemas/prompt-schema.json"
      },
      {
        "fileMatch": "**/*.flightpath.json",
        "url": "./schemas/flightpath-schema.json"
      }
    ],
    "languageModelTools": [
      {
        "name": "flightpath_response_complete",
        "toolReferenceName": "flightpath_response_complete",
        "displayName": "FlightPath Response Complete",
        "modelDescription": "Call this tool when you have finished responding to a FlightPath prompt to signal completion. This allows FlightPath to proceed to the next step in the workflow.",
        "canBeReferencedInPrompt": true
      }
    ]
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npm run package",
    "package": "npm run check-types && node esbuild.js --production",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.6",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "mocha": "^11.7.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "chokidar": "^4.0.3",
    "jsonschema": "^1.5.0"
  }
}
