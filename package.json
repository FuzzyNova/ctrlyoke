{
  "name": "ctrlyoke",
  "displayName": "ctrlyoke",
  "description": "One workflow engine for every CLI coding agent. Prompt, steer, automate, and revisit sessions across Copilot CLI, Claude Code, Codex, OpenCode, Qwen Code, and Antigravity — one message or a whole validated workflow.",
  "version": "0.2.0",
  "publisher": "fuzzynova",
  "license": "SEE LICENSE IN LICENSE.md",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/FuzzyNova/ctrlyoke"
  },
  "homepage": "https://ctrlyoke.dev",
  "bugs": {
    "url": "https://github.com/FuzzyNova/ctrlyoke/issues"
  },
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "AI",
    "automation",
    "copilot",
    "claude",
    "codex",
    "antigravity",
    "opencode",
    "qwen",
    "workflow",
    "prompt",
    "agent",
    "LLM"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.ctrlyoke.yaml",
    "workspaceContains:**/*.ctrlyoke.yml",
    "workspaceContains:**/*.ctrlyoke.json",
    "workspaceContains:**/*.prompt.md"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "restrictedConfigurations": [
        "ctrlyoke.workspaceDirectory"
      ]
    }
  },
  "bin": {
    "ctrlyoke-mcp": "./out/mcp-server.js",
    "ctrlyoke": "./out/cli.js"
  },
  "contributes": {
    "configuration": {
      "title": "ctrlyoke",
      "properties": {
        "ctrlyoke.workspaceDirectory": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Directory that contains the `.ctrlyoke` folder for this workspace. Leave empty to auto-detect: the folder of the `.code-workspace` file when one is open, otherwise the first workspace folder. Accepts an absolute path or a path relative to the workspace file. Supports `${workspaceFolder}` and `${workspaceFolder:Name}`."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "ctrlyoke.workflowMcpProvider",
        "label": "ctrlyoke Workflow MCPs"
      }
    ],
    "submenus": [
      {
        "id": "ctrlyoke.runSubmenu",
        "label": "Run with ctrlyoke",
        "icon": "$(play)"
      }
    ],
    "commands": [
      {
        "command": "ctrlyoke.openPanel",
        "title": "Open ctrlyoke Panel",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.enableServer",
        "title": "Start Hosted Dashboard Server",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.disableServer",
        "title": "Stop Hosted Dashboard Server",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.manageWorktrees",
        "title": "Manage Worktrees",
        "category": "ctrlyoke",
        "icon": "$(source-control)"
      },
      {
        "command": "ctrlyoke.refreshHarnessUsage",
        "title": "Refresh Harness Usage",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.refreshWorkspaceStats",
        "title": "Refresh Workspace Statistics",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.reviewWorkspaceSettingsTrust",
        "title": "Review Workspace Settings That Run Programs",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.showGettingStarted",
        "title": "Show Getting Started",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.installCli",
        "title": "Install CLI for Use Outside VS Code",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.activatePro",
        "title": "Activate Pro License",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.activateOfflinePro",
        "title": "Activate Offline (Air-Gapped) License",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.deactivatePro",
        "title": "Deactivate Pro License",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.manageLicense",
        "title": "Manage License",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.pause",
        "title": "Pause Execution",
        "category": "ctrlyoke",
        "icon": "$(debug-pause)"
      },
      {
        "command": "ctrlyoke.resume",
        "title": "Resume Execution",
        "category": "ctrlyoke",
        "icon": "$(debug-continue)"
      },
      {
        "command": "ctrlyoke.stop",
        "title": "Stop Execution",
        "category": "ctrlyoke",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ctrlyoke.devMenu",
        "title": "Developer Tools",
        "category": "ctrlyoke",
        "icon": "$(beaker)"
      },
      {
        "command": "ctrlyoke.newWorkflow",
        "title": "New Workflow from Template",
        "category": "ctrlyoke",
        "icon": "$(new-file)"
      },
      {
        "command": "ctrlyoke.createNewTemplate",
        "title": "Create New Custom Template",
        "category": "ctrlyoke",
        "icon": "$(file-add)"
      },
      {
        "command": "ctrlyoke.runFromContext",
        "title": "Run with ctrlyoke",
        "category": "ctrlyoke",
        "icon": "$(send)"
      },
      {
        "command": "ctrlyoke.loadFromContext",
        "title": "Load in ctrlyoke",
        "category": "ctrlyoke",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "ctrlyoke.selectPromptFile",
        "title": "Select Prompt File",
        "category": "ctrlyoke",
        "icon": "$(file)"
      },
      {
        "command": "ctrlyoke.resumeSession",
        "title": "Resume Session",
        "category": "ctrlyoke",
        "icon": "$(history)"
      },
      {
        "command": "ctrlyoke.run",
        "title": "Run",
        "category": "ctrlyoke",
        "icon": "$(play)"
      },
      {
        "command": "ctrlyoke.showOutputPanel",
        "title": "Show Output Panel",
        "category": "ctrlyoke",
        "icon": "$(output)"
      },
      {
        "command": "ctrlyoke.queueFromContext",
        "title": "Queue Steps with ctrlyoke",
        "category": "ctrlyoke",
        "icon": "$(add)"
      },
      {
        "command": "ctrlyoke.queueNextFromContext",
        "title": "Queue Steps Next with ctrlyoke",
        "category": "ctrlyoke",
        "icon": "$(insert)"
      },
      {
        "command": "ctrlyoke.clearWorkflow",
        "title": "New Blank Workflow",
        "category": "ctrlyoke",
        "icon": "$(add)"
      },
      {
        "command": "ctrlyoke.appendFromDashboard",
        "title": "Queue Prompt File",
        "category": "ctrlyoke",
        "icon": "$(insert)"
      },
      {
        "command": "ctrlyoke.initWorkspace",
        "title": "Initialize Workspace",
        "category": "ctrlyoke",
        "icon": "$(folder-opened)"
      },
      {
        "command": "ctrlyoke.addFileToPromptEditor",
        "title": "Add File to ctrlyoke",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.addDirectoryToPromptEditor",
        "title": "Add Directory to ctrlyoke",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.addSelectionToPromptEditor",
        "title": "Add Selection to ctrlyoke",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.addSymbolToPromptEditor",
        "title": "Add Symbol to ctrlyoke",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.addOutputSelectionToPromptEditor",
        "title": "Add Output Selection to ctrlyoke",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.addOutputChannelToPromptEditor",
        "title": "Add Output Channel to ctrlyoke",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.addScmResourcesToPromptEditor",
        "title": "Add File to ctrlyoke",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.addTimelineCommitToPromptEditor",
        "title": "Add Commit to ctrlyoke",
        "category": "ctrlyoke"
      },
      {
        "command": "ctrlyoke.searchHistory",
        "title": "Search ctrlyoke History",
        "category": "ctrlyoke",
        "icon": "$(search)"
      },
      {
        "command": "ctrlyoke.generateCommitMessage",
        "title": "Generate Commit Message with ctrlyoke",
        "category": "ctrlyoke",
        "icon": {
          "light": "images/ctrlyoke-icon-light.svg",
          "dark": "images/ctrlyoke-icon-dark.svg"
        }
      },
      {
        "command": "ctrlyoke.cancelCommitMessageGeneration",
        "title": "Cancel Commit Message Generation",
        "category": "ctrlyoke",
        "icon": "$(stop-circle)"
      }
    ],
    "keybindings": [
      {
        "command": "ctrlyoke.clearWorkflow",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "focusedView == 'ctrlyoke.dashboard'"
      },
      {
        "command": "ctrlyoke.newWorkflow",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "focusedView == 'ctrlyoke.dashboard'"
      },
      {
        "command": "ctrlyoke.selectPromptFile",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "focusedView == 'ctrlyoke.dashboard'"
      },
      {
        "command": "ctrlyoke.appendFromDashboard",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "when": "focusedView == 'ctrlyoke.dashboard'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ctrlyoke.openPanel"
        },
        {
          "command": "ctrlyoke.resumeSession"
        },
        {
          "command": "ctrlyoke.pause"
        },
        {
          "command": "ctrlyoke.resume"
        },
        {
          "command": "ctrlyoke.stop"
        },
        {
          "command": "ctrlyoke.devMenu",
          "when": "ctrlyoke.devMode"
        },
        {
          "command": "ctrlyoke.runFromContext",
          "when": "false"
        },
        {
          "command": "ctrlyoke.loadFromContext",
          "when": "false"
        },
        {
          "command": "ctrlyoke.queueFromContext",
          "when": "false"
        },
        {
          "command": "ctrlyoke.queueNextFromContext",
          "when": "false"
        },
        {
          "command": "ctrlyoke.addFileToPromptEditor",
          "when": "false"
        },
        {
          "command": "ctrlyoke.addDirectoryToPromptEditor",
          "when": "false"
        },
        {
          "command": "ctrlyoke.addSelectionToPromptEditor",
          "when": "false"
        },
        {
          "command": "ctrlyoke.addSymbolToPromptEditor",
          "when": "false"
        },
        {
          "command": "ctrlyoke.addOutputSelectionToPromptEditor",
          "when": "false"
        },
        {
          "command": "ctrlyoke.addOutputChannelToPromptEditor",
          "when": "false"
        },
        {
          "command": "ctrlyoke.addScmResourcesToPromptEditor",
          "when": "false"
        },
        {
          "command": "ctrlyoke.addTimelineCommitToPromptEditor",
          "when": "false"
        },
        {
          "command": "ctrlyoke.generateCommitMessage",
          "when": "!ctrlyoke.generatingCommitMessage"
        },
        {
          "command": "ctrlyoke.cancelCommitMessageGeneration",
          "when": "ctrlyoke.generatingCommitMessage"
        }
      ],
      "ctrlyoke.runSubmenu": [
        {
          "command": "ctrlyoke.runFromContext",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file"
        },
        {
          "command": "ctrlyoke.loadFromContext",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file"
        },
        {
          "command": "ctrlyoke.queueFromContext",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file && ctrlyoke.hasQueuedSteps"
        },
        {
          "command": "ctrlyoke.queueNextFromContext",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file && ctrlyoke.hasQueuedSteps"
        }
      ],
      "explorer/context": [
        {
          "submenu": "ctrlyoke.runSubmenu",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "z_ctrlyoke@1"
        },
        {
          "command": "ctrlyoke.addFileToPromptEditor",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "z_ctrlyoke@2"
        },
        {
          "command": "ctrlyoke.addDirectoryToPromptEditor",
          "when": "explorerResourceIsFolder",
          "group": "z_ctrlyoke@2"
        }
      ],
      "editor/title": [
        {
          "submenu": "ctrlyoke.runSubmenu",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "ctrlyoke.runSubmenu",
          "when": "resourceFilename =~ /\\.(ctrlyoke\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "z_ctrlyoke@1"
        },
        {
          "command": "ctrlyoke.addFileToPromptEditor",
          "when": "resourceScheme == file",
          "group": "z_ctrlyoke@2"
        }
      ],
      "editor/context": [
        {
          "command": "ctrlyoke.addSelectionToPromptEditor",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "z_ctrlyoke@1"
        },
        {
          "command": "ctrlyoke.addSymbolToPromptEditor",
          "when": "!editorHasSelection && resourceScheme == file",
          "group": "z_ctrlyoke@2"
        },
        {
          "command": "ctrlyoke.addOutputSelectionToPromptEditor",
          "when": "inOutput && editorHasSelection",
          "group": "z_ctrlyoke@3"
        },
        {
          "command": "ctrlyoke.addOutputChannelToPromptEditor",
          "when": "inOutput && !editorHasSelection",
          "group": "z_ctrlyoke@3"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "ctrlyoke.addSelectionToPromptEditor",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "z_ctrlyoke@1"
        },
        {
          "command": "ctrlyoke.addSymbolToPromptEditor",
          "when": "!editorHasSelection && resourceScheme == file",
          "group": "z_ctrlyoke@2"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "ctrlyoke.addScmResourcesToPromptEditor",
          "when": "scmProvider == git",
          "group": "z_ctrlyoke"
        }
      ],
      "scm/resourceFolder/context": [
        {
          "command": "ctrlyoke.addScmResourcesToPromptEditor",
          "when": "scmProvider == git",
          "group": "z_ctrlyoke"
        }
      ],
      "timeline/item/context": [
        {
          "command": "ctrlyoke.addTimelineCommitToPromptEditor",
          "when": "timelineItem =~ /git:file:commit\\b/",
          "group": "z_ctrlyoke"
        }
      ],
      "scm/title": [
        {
          "command": "ctrlyoke.generateCommitMessage",
          "when": "scmProvider == git && !ctrlyoke.generatingCommitMessage",
          "group": "navigation@-1"
        },
        {
          "command": "ctrlyoke.cancelCommitMessageGeneration",
          "when": "scmProvider == git && ctrlyoke.generatingCommitMessage",
          "group": "navigation@-1"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "ctrlyoke",
          "title": "ctrlyoke",
          "icon": "images/ctrlyoke-sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "ctrlyoke": [
        {
          "type": "webview",
          "id": "ctrlyoke.dashboard",
          "name": "ctrlyoke",
          "icon": "images/ctrlyoke-icon.svg"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "ctrlyoke.gettingStarted",
        "title": "Getting Started with ctrlyoke",
        "description": "Run your first AI coding workflow: verify a harness, create a workflow from a template, run it, and know where to get help.",
        "icon": "images/ctrlyoke-icon-color.png",
        "steps": [
          {
            "id": "openPanel",
            "title": "Open the ctrlyoke panel",
            "description": "ctrlyoke runs AI coding CLIs through multi-step workflows. Everything happens in one dashboard: your steps, live output, the prompt editor and workflow settings.\n[Open ctrlyoke Panel](command:ctrlyoke.openPanel)",
            "media": {
              "image": {
                "dark": "images/screenshots/walkthrough-open-panel-dark-2400x1500.png",
                "light": "images/screenshots/walkthrough-open-panel-light-2400x1500.png",
                "hc": "images/screenshots/walkthrough-open-panel-hc-2400x1500.png",
                "hcLight": "images/screenshots/walkthrough-open-panel-hclight-2400x1500.png"
              },
              "altText": "The ctrlyoke dashboard in VS Code's bottom panel after a finished run: the step list, streamed output, the prompt editor and the workflow properties."
            },
            "completionEvents": [
              "onView:ctrlyoke.dashboard"
            ]
          },
          {
            "id": "verifyHarness",
            "title": "Install and verify a harness CLI",
            "description": "ctrlyoke doesn't bundle an AI CLI. It drives one you install and sign in to: Copilot CLI, Claude Code, Codex, OpenCode, Qwen Code or Antigravity. If none is found, the dashboard lists the install command for each, with a copy button.\n[Installation guide](https://ctrlyoke.dev/docs/guide/installation#install-a-harness)",
            "media": {
              "image": {
                "dark": "images/screenshots/walkthrough-verify-harness-dark-2400x1380.png",
                "light": "images/screenshots/walkthrough-verify-harness-light-2400x1380.png",
                "hc": "images/screenshots/walkthrough-verify-harness-hc-2400x1380.png",
                "hcLight": "images/screenshots/walkthrough-verify-harness-hclight-2400x1380.png"
              },
              "altText": "Two panels side by side. Left: a warning that no CLI coding agent is available, listing an install command for each of the six harnesses. Right: the harness picker open, with the detected harnesses marked available."
            },
            "completionEvents": [
              "onContext:ctrlyoke.harnessDetected"
            ]
          },
          {
            "id": "createWorkflow",
            "title": "Create a workflow from a template",
            "description": "A template builds a multi-step workflow from a few variables you fill in.\n[New Workflow from Template](command:ctrlyoke.newWorkflow)",
            "media": {
              "image": {
                "dark": "images/screenshots/walkthrough-create-workflow-dark-2400x1500.png",
                "light": "images/screenshots/walkthrough-create-workflow-light-2400x1500.png",
                "hc": "images/screenshots/walkthrough-create-workflow-hc-2400x1500.png",
                "hcLight": "images/screenshots/walkthrough-create-workflow-hclight-2400x1500.png"
              },
              "altText": "The Create Workflow from Template dialog with the Simple Feature template selected, a feature description filled in, and the workflow named Notes API."
            },
            "completionEvents": [
              "onCommand:ctrlyoke.newWorkflow"
            ]
          },
          {
            "id": "runWorkflow",
            "title": "Run it and read the output",
            "description": "**Run** sends each step to your harness, checks its end condition, then moves on to the next step. Output, tool calls and diffs stream in live.\n[Run](command:ctrlyoke.run)",
            "media": {
              "image": {
                "dark": "images/screenshots/walkthrough-run-workflow-dark-1200x750.gif",
                "light": "images/screenshots/walkthrough-run-workflow-dark-1200x750.gif",
                "hc": "images/screenshots/walkthrough-run-workflow-dark-1200x750.gif",
                "hcLight": "images/screenshots/walkthrough-run-workflow-dark-1200x750.gif"
              },
              "altText": "A short recording: Run is clicked on the Notes API workflow, the plan step streams its output, then the implement step starts and writes package.json, server.js and .gitignore."
            },
            "completionEvents": [
              "onCommand:ctrlyoke.run"
            ]
          },
          {
            "id": "installCli",
            "title": "Optional: use the CLI outside VS Code",
            "description": "The `ctrlyoke` command already works in VS Code's terminals. For other shells and CI, install the matching version from npm (needs Node.js 22.12 or later).\n[Install CLI](command:ctrlyoke.installCli)",
            "media": {
              "image": {
                "dark": "images/screenshots/walkthrough-install-cli-dark-2400x1500.png",
                "light": "images/screenshots/walkthrough-install-cli-light-2400x1500.png",
                "hc": "images/screenshots/walkthrough-install-cli-hc-2400x1500.png",
                "hcLight": "images/screenshots/walkthrough-install-cli-hclight-2400x1500.png"
              },
              "altText": "VS Code's integrated terminal running ctrlyoke --version, then ctrlyoke --help, which lists the available commands."
            },
            "completionEvents": [
              "onCommand:ctrlyoke.installCli"
            ]
          },
          {
            "id": "getHelp",
            "title": "Get help when you're stuck",
            "description": "Pick the **ctrlyoke-tech-support** agent in the Agent picker and ask it anything about the dashboard, workflow files or harnesses.\n[Open the docs](https://ctrlyoke.dev/docs)",
            "media": {
              "image": {
                "dark": "images/screenshots/walkthrough-get-help-dark-2400x1500.png",
                "light": "images/screenshots/walkthrough-get-help-light-2400x1500.png",
                "hc": "images/screenshots/walkthrough-get-help-hc-2400x1500.png",
                "hcLight": "images/screenshots/walkthrough-get-help-hclight-2400x1500.png"
              },
              "altText": "The Agent picker open with Ctrlyoke Tech Support highlighted, beside its answer to a question about attaching files in the prompt editor."
            },
            "completionEvents": [
              "onLink:https://ctrlyoke.dev/docs"
            ]
          }
        ],
        "featuredFor": [
          "**/*.ctrlyoke.yaml",
          "**/*.ctrlyoke.yml",
          "**/*.ctrlyoke.json",
          "**/*.prompt.md"
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/*.ctrlyoke.json"
        ],
        "url": "./out/schemas/workflow-schema.json"
      },
      {
        "fileMatch": [
          "**/.ctrlyoke/settings.json"
        ],
        "url": "./out/schemas/settings-schema.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "ctrlyoke.prompt-markdown.injection",
        "path": "./syntaxes/ctrlyoke-prompt-markdown.injection.json",
        "injectTo": [
          "source.yaml"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.markdown": "markdown",
          "meta.embedded.inline.markdown": "markdown"
        }
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "**/*.ctrlyoke.yaml",
