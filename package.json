{
  "name": "flightpath",
  "displayName": "FlightPath",
  "description": "Automate AI coding assistants (Copilot, Claude, Codex, Gemini) through structured YAML/JSON prompt workflows with sequential execution, retry logic, and a live dashboard.",
  "version": "0.1.0",
  "publisher": "nhickster",
  "license": "Elastic-2.0",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nhickster/flightpath"
  },
  "homepage": "https://github.com/nhickster/flightpath#readme",
  "bugs": {
    "url": "https://github.com/nhickster/flightpath/issues"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "AI",
    "automation",
    "copilot",
    "claude",
    "codex",
    "gemini",
    "workflow",
    "prompt",
    "agent",
    "LLM"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.flightpath.yaml",
    "workspaceContains:**/*.flightpath.yml",
    "workspaceContains:**/*.flightpath.json",
    "workspaceContains:**/*.prompt.md"
  ],
  "main": "./out/extension.js",
  "bin": {
    "flightpath-mcp": "./out/mcp-server.js",
    "flightpath": "./out/cli.js"
  },
  "contributes": {
    "configuration": {
      "title": "FlightPath",
      "properties": {
        "flightpath.workspaceDirectory": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Directory that contains the `.flightpath` folder for this workspace. Leave empty to auto-detect: the folder of the `.code-workspace` file when one is open, otherwise the first workspace folder. Accepts an absolute path or a path relative to the workspace file. Supports `${workspaceFolder}` and `${workspaceFolder:Name}`."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "flightpath.workflowMcpProvider",
        "label": "FlightPath Workflow MCPs"
      }
    ],
    "commands": [
      {
        "command": "flightpath.openPanel",
        "title": "Open FlightPath Panel",
        "category": "FlightPath"
      },
      {
        "command": "flightpath.createPromptFile",
        "title": "Create Prompt File",
        "category": "FlightPath"
      },
      {
        "command": "flightpath.pause",
        "title": "Pause Execution",
        "category": "FlightPath",
        "icon": "$(debug-pause)"
      },
      {
        "command": "flightpath.resume",
        "title": "Resume Execution",
        "category": "FlightPath",
        "icon": "$(debug-continue)"
      },
      {
        "command": "flightpath.stop",
        "title": "Stop Execution",
        "category": "FlightPath",
        "icon": "$(debug-stop)"
      },
      {
        "command": "flightpath.devMenu",
        "title": "Developer Tools",
        "category": "FlightPath",
        "icon": "$(beaker)"
      },
      {
        "command": "flightpath.createEndConditionScript",
        "title": "Create End Condition Script",
        "category": "FlightPath",
        "icon": "$(new-file)"
      },
      {
        "command": "flightpath.importAgents",
        "title": "Import FlightPath Agents",
        "category": "FlightPath",
        "icon": "$(hubot)"
      },
      {
        "command": "flightpath.importWorkflowTemplates",
        "title": "Import Workflow Templates",
        "category": "FlightPath",
        "icon": "$(file-code)"
      },
      {
        "command": "flightpath.newWorkflow",
        "title": "New Workflow from Template",
        "category": "FlightPath",
        "icon": "$(new-file)"
      },
      {
        "command": "flightpath.createNewTemplate",
        "title": "Create New Custom Template",
        "category": "FlightPath",
        "icon": "$(file-add)"
      },
      {
        "command": "flightpath.runFromContext",
        "title": "Run with FlightPath",
        "category": "FlightPath",
        "icon": "$(send)"
      },
      {
        "command": "flightpath.loadFromContext",
        "title": "Load in FlightPath",
        "category": "FlightPath",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "flightpath.selectPromptFile",
        "title": "Select Prompt File",
        "category": "FlightPath",
        "icon": "$(file)"
      },
      {
        "command": "flightpath.resumeSession",
        "title": "Resume Session",
        "category": "FlightPath",
        "icon": "$(history)"
      },
      {
        "command": "flightpath.run",
        "title": "Run",
        "category": "FlightPath",
        "icon": "$(play)"
      },
      {
        "command": "flightpath.showOutputPanel",
        "title": "Show Output Panel",
        "category": "FlightPath",
        "icon": "$(output)"
      },
      {
        "command": "flightpath.createDraftPrompt",
        "title": "New Draft Prompt",
        "category": "FlightPath",
        "icon": "$(new-file)"
      },
      {
        "command": "flightpath.queueFromContext",
        "title": "Queue with FlightPath",
        "category": "FlightPath",
        "icon": "$(add)"
      },
      {
        "command": "flightpath.queueNextFromContext",
        "title": "Queue Next with FlightPath",
        "category": "FlightPath",
        "icon": "$(insert)"
      },
      {
        "command": "flightpath.clearWorkflow",
        "title": "New Blank Workflow",
        "category": "FlightPath",
        "icon": "$(add)"
      },
      {
        "command": "flightpath.appendFromDashboard",
        "title": "Queue Prompt File",
        "category": "FlightPath",
        "icon": "$(insert)"
      },
      {
        "command": "flightpath.initWorkspace",
        "title": "Initialize Workspace",
        "category": "FlightPath",
        "icon": "$(folder-opened)"
      },
      {
        "command": "flightpath.addFileToPromptEditor",
        "title": "Add File to FlightPath",
        "category": "FlightPath"
      },
      {
        "command": "flightpath.addDirectoryToPromptEditor",
        "title": "Add Directory to FlightPath",
        "category": "FlightPath"
      },
      {
        "command": "flightpath.addSelectionToPromptEditor",
        "title": "Add Selection to FlightPath",
        "category": "FlightPath"
      },
      {
        "command": "flightpath.addSymbolToPromptEditor",
        "title": "Add Symbol to FlightPath",
        "category": "FlightPath"
      },
      {
        "command": "flightpath.addScmResourcesToPromptEditor",
        "title": "Add File to FlightPath",
        "category": "FlightPath"
      },
      {
        "command": "flightpath.addTimelineCommitToPromptEditor",
        "title": "Add Commit to FlightPath",
        "category": "FlightPath"
      },
      {
        "command": "flightpath.searchHistory",
        "title": "Search FlightPath History",
        "category": "FlightPath",
        "icon": "$(search)"
      },
      {
        "command": "flightpath.generateCommitMessage",
        "title": "Generate Commit Message with FlightPath",
        "category": "FlightPath",
        "icon": {
          "light": "images/flightpath-icon-simple-light.svg",
          "dark": "images/flightpath-icon-simple-dark.svg"
        }
      },
      {
        "command": "flightpath.cancelCommitMessageGeneration",
        "title": "Cancel Commit Message Generation",
        "category": "FlightPath",
        "icon": "$(stop-circle)"
      }
    ],
    "keybindings": [
      {
        "command": "flightpath.clearWorkflow",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "focusedView == 'flightpath.dashboard'"
      },
      {
        "command": "flightpath.newWorkflow",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "focusedView == 'flightpath.dashboard'"
      },
      {
        "command": "flightpath.selectPromptFile",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "focusedView == 'flightpath.dashboard'"
      },
      {
        "command": "flightpath.appendFromDashboard",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "when": "focusedView == 'flightpath.dashboard'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "flightpath.openPanel"
        },
        {
          "command": "flightpath.createPromptFile"
        },
        {
          "command": "flightpath.resumeSession"
        },
        {
          "command": "flightpath.pause"
        },
        {
          "command": "flightpath.resume"
        },
        {
          "command": "flightpath.stop"
        },
        {
          "command": "flightpath.devMenu",
          "when": "flightpath.devMode"
        },
        {
          "command": "flightpath.createEndConditionScript"
        },
        {
          "command": "flightpath.importAgents"
        },
        {
          "command": "flightpath.importWorkflowTemplates"
        },
        {
          "command": "flightpath.runFromContext",
          "when": "false"
        },
        {
          "command": "flightpath.loadFromContext",
          "when": "false"
        },
        {
          "command": "flightpath.queueFromContext",
          "when": "false"
        },
        {
          "command": "flightpath.queueNextFromContext",
          "when": "false"
        },
        {
          "command": "flightpath.addFileToPromptEditor",
          "when": "false"
        },
        {
          "command": "flightpath.addDirectoryToPromptEditor",
          "when": "false"
        },
        {
          "command": "flightpath.addSelectionToPromptEditor",
          "when": "false"
        },
        {
          "command": "flightpath.addSymbolToPromptEditor",
          "when": "false"
        },
        {
          "command": "flightpath.addScmResourcesToPromptEditor",
          "when": "false"
        },
        {
          "command": "flightpath.addTimelineCommitToPromptEditor",
          "when": "false"
        },
        {
          "command": "flightpath.generateCommitMessage",
          "when": "!flightpath.generatingCommitMessage"
        },
        {
          "command": "flightpath.cancelCommitMessageGeneration",
          "when": "flightpath.generatingCommitMessage"
        }
      ],
      "explorer/context": [
        {
          "command": "flightpath.createPromptFile",
          "when": "explorerResourceIsFolder",
          "group": "2_workspace"
        },
        {
          "command": "flightpath.runFromContext",
          "when": "resourceFilename =~ /\\.(flightpath\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "flightpath@1"
        },
        {
          "command": "flightpath.loadFromContext",
          "when": "resourceFilename =~ /\\.(flightpath\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "flightpath@2"
        },
        {
          "command": "flightpath.queueFromContext",
          "when": "resourceFilename =~ /\\.(flightpath\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "flightpath@3"
        },
        {
          "command": "flightpath.queueNextFromContext",
          "when": "resourceFilename =~ /\\.(flightpath\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "flightpath@4"
        },
        {
          "command": "flightpath.addFileToPromptEditor",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "flightpath@5"
        },
        {
          "command": "flightpath.addDirectoryToPromptEditor",
          "when": "explorerResourceIsFolder",
          "group": "flightpath@5"
        }
      ],
      "editor/title": [
        {
          "command": "flightpath.runFromContext",
          "when": "resourceFilename =~ /\\.(flightpath\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "navigation"
        },
        {
          "command": "flightpath.queueFromContext",
          "when": "resourceFilename =~ /\\.(flightpath\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "navigation@2"
        },
        {
          "command": "flightpath.queueNextFromContext",
          "when": "resourceFilename =~ /\\.(flightpath\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "navigation@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "flightpath.runFromContext",
          "when": "resourceFilename =~ /\\.(flightpath\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "flightpath@1"
        },
        {
          "command": "flightpath.loadFromContext",
          "when": "resourceFilename =~ /\\.(flightpath\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "flightpath@2"
        },
        {
          "command": "flightpath.queueFromContext",
          "when": "resourceFilename =~ /\\.(flightpath\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "flightpath@3"
        },
        {
          "command": "flightpath.queueNextFromContext",
          "when": "resourceFilename =~ /\\.(flightpath\\.(yaml|yml|json)|prompt\\.md)$/ && resourceScheme == file",
          "group": "flightpath@4"
        },
        {
          "command": "flightpath.addFileToPromptEditor",
          "when": "resourceScheme == file",
          "group": "flightpath@5"
        }
      ],
      "editor/context": [
        {
          "command": "flightpath.addSelectionToPromptEditor",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "2_flightpath@1"
        },
        {
          "command": "flightpath.addSymbolToPromptEditor",
          "when": "!editorHasSelection && resourceScheme == file",
          "group": "2_flightpath@2"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "flightpath.addSelectionToPromptEditor",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "2_flightpath@1"
        },
        {
          "command": "flightpath.addSymbolToPromptEditor",
          "when": "!editorHasSelection && resourceScheme == file",
          "group": "2_flightpath@2"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "flightpath.addScmResourcesToPromptEditor",
          "when": "scmProvider == git",
          "group": "2_flightpath"
        }
      ],
      "scm/resourceFolder/context": [
        {
          "command": "flightpath.addScmResourcesToPromptEditor",
          "when": "scmProvider == git",
          "group": "2_flightpath"
        }
      ],
      "timeline/item/context": [
        {
          "command": "flightpath.addTimelineCommitToPromptEditor",
          "when": "timelineItem =~ /git:file:commit\\b/",
          "group": "2_flightpath"
        }
      ],
      "scm/title": [
        {
          "command": "flightpath.generateCommitMessage",
          "when": "scmProvider == git && !flightpath.generatingCommitMessage",
          "group": "navigation@-1"
        },
        {
          "command": "flightpath.cancelCommitMessageGeneration",
          "when": "scmProvider == git && flightpath.generatingCommitMessage",
          "group": "navigation@-1"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "flightpath",
          "title": "FlightPath",
          "icon": "images/flightpath-sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "flightpath": [
        {
          "type": "webview",
          "id": "flightpath.dashboard",
          "name": "FlightPath",
          "icon": "images/flightpath-icon.svg"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "flightpath_queue_status",
        "toolReferenceName": "flightpath_queue_status",
        "displayName": "FlightPath Queue Status",
        "modelDescription": "Get comprehensive status of the current FlightPath workflow queue, including metadata and all prompts with their execution state",
        "canBeReferencedInPrompt": true,
        "tags": [
          "queue",
          "status",
          "workflow"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "flightpath_append_queue",
        "toolReferenceName": "flightpath_append_queue",
        "displayName": "FlightPath Append Queue",
        "modelDescription": "Append prompts to the current FlightPath workflow queue. Use when you want to extend the workflow with additional tasks. Supports inserting after current position ('next') or at end of queue ('end').",
        "canBeReferencedInPrompt": true,
        "tags": [
          "queue",
          "append",
          "workflow",
          "extend"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "description": "The prompt text to add to the queue"
                  },
                  "model": {
                    "type": "string",
                    "description": "Optional model override (e.g., 'claude-sonnet-4.5', 'gpt-5')"
                  }
                },
                "required": [
                  "prompt"
                ]
              },
              "description": "Array of prompts to add to the queue"
            },
            "position": {
              "type": "string",
              "enum": [
                "next",
                "end"
              ],
              "description": "Where to insert prompts: 'next' (after current) or 'end' (at end of queue)"
            },
            "source": {
              "type": "string",
              "description": "Source identifier (e.g., 'copilot-chat', 'AI-generated tasks')"
            },
            "reason": {
              "type": "string",
              "description": "Optional explanation for why these prompts are being added"
            }
          },
          "required": [
            "prompts",
            "position"
          ]
        }
      },
      {
        "name": "flightpath_capabilities",
        "toolReferenceName": "flightpath_capabilities",
        "displayName": "FlightPath Capabilities",
        "modelDescription": "Get the available FlightPath harnesses and their supported models",
        "canBeReferencedInPrompt": true,
        "tags": [
          "harness",
          "model",
          "capabilities"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "flightpath_read_output",
        "toolReferenceName": "flightpath_read_output",
        "displayName": "FlightPath Read Output",
        "modelDescription": "Read AI response output from completed prompts in the FlightPath workflow queue",
        "canBeReferencedInPrompt": true,
        "tags": [
          "queue",
          "output",
          "workflow"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "indices": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "Array of prompt indices to read output for (0-based). Empty array returns all outputs."
            }
          }
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/*.flightpath.json"
        ],
        "url": "./schemas/prompt-schema.json"
      },
      {
        "fileMatch": [
          "**/.flightpath/settings.json"
        ],
        "url": "./schemas/settings-schema.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "**/*.flightpath.yaml",
          "**/*.flightpath.yml"
        ],
        "url": "./schemas/prompt-schema.yaml"
      }
    ]
  },
  "scripts": {
    "generate-schema": "node scripts/generate-yaml-schema.mjs",
    "generate-agent-files": "node scripts/generate-agent-files.mjs",
    "generate-sidebar-icon": "node scripts/generate-sidebar-icon.mjs",
    "generate-custom-icons": "node scripts/generate-custom-icons.mjs",
    "generate-app-icons": "node scripts/generate-app-icons.mjs",
    "generate-icons": "npm run generate-sidebar-icon && npm run generate-custom-icons && npm run generate-app-icons",
    "precompile": "npm run generate-schema && npm run generate-icons",
    "compile": "npm run compile:extension && npm run compile:webview",
    "compile:extension": "npm run typecheck:extension && node esbuild.js",
    "compile:webview": "npm run generate-custom-icons && npm run typecheck:webview && vite build --config src/ui/webview-react/vite.config.ts --mode development",
    "compile:webview:react-debug": "npm run generate-custom-icons && vite build --config src/ui/webview-react/vite.config.ts --mode react-debug",
    "compile:react-debug": "npm run compile:extension && npm run compile:webview:react-debug",
    "compile-tests": "tsc -p .",
    "typecheck": "npm-run-all typecheck:extension typecheck:webview",
    "typecheck:extension": "tsc --noEmit",
    "typecheck:webview": "tsc --noEmit -p src/ui/webview-react/tsconfig.json",
    "watch": "npm-run-all -p watch:extension watch:webview",
    "watch:extension": "node esbuild.js --watch",
    "watch:webview": "npm run generate-custom-icons && vite build --watch --config src/ui/webview-react/vite.config.ts --mode development",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "dev:webview": "npm run generate-custom-icons && vite --config src/ui/webview-react/vite.config.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "vscode:prepublish": "npm run build:prod",
    "build:prod": "npm run build:extension && npm run build:webview",
    "build:extension": "npm run typecheck:extension && node scripts/strip-dev-commands.mjs && node esbuild.js --production",
    "build:webview": "npm run generate-custom-icons && npm run typecheck:webview && vite build --config src/ui/webview-react/vite.config.ts --mode production",
    "package": "vsce package && node scripts/strip-dev-commands.mjs --restore",
    "strip-dev-commands": "node scripts/strip-dev-commands.mjs",
    "restore-package": "node scripts/strip-dev-commands.mjs --restore",
    "pretest": "npm run compile && npm run compile-tests && node esbuild.js",
    "test": "node ./out/test/runTest.js && npm run test:ui",
    "pretest:headless": "npm run compile && npm run compile-tests && node esbuild.js",
    "test:headless": "xvfb-run -a node ./out/test/runTest.js && npm run test:ui",
    "test:ui": "vitest run --config src/ui/webview-react/vitest.config.ts",
    "test:ui:watch": "vitest --config src/ui/webview-react/vitest.config.ts",
    "test:ui:coverage": "vitest run --coverage --config src/ui/webview-react/vitest.config.ts",
    "test:unit": "node ./out/test/runTest.js --grep \"^(CliIntegration|CopilotChatIntegration)\"",
    "pretest:harness": "npm run compile-tests && node esbuild.js",
    "test:harness": "mocha --ui tdd --timeout 900000 --reporter spec \"out/test/harness/**/*.test.js\"",
    "test:integration": "cross-env COPILOT_CLI_INTEGRATION_TESTS=1 npm test",
    "test:watch": "npm run compile && npm test -- --watch",
    "test:coverage": "nyc npm test",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-models": "node scripts/sync-models.mjs",
    "sync-models:check": "node scripts/sync-models.mjs --check",
    "sync-models:import": "node scripts/sync-models.mjs --import",
    "chores": "node scripts/chores.mjs",
    "compile:prod": "npm run compile:extension && npm run build:webview",
    "knip": "knip"
  },
  "devDependencies": {
    "@lezer/highlight": "^1.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.8",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
