{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FlightPath Workflow Schema",
  "type": "object",
  "properties": {
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string"
          },
          "endCondition": {
            "$ref": "#/definitions/endCondition"
          }
        },
        "required": ["prompt"]
      }
    }
  },
  "required": ["prompts"],
  "additionalProperties": false,
  "definitions": {
    "endCondition": {
      "type": "object",
      "properties": {
        "script": {
          "type": "string",
          "description": "Path to script file to execute"
        },
        "returns": {
          "type": "string",
          "description": "Expected return value from script"
        },
        "timeout": {
          "type": "number",
          "description": "Timeout in milliseconds"
        }
      },
      "required": ["script", "returns"]
    }
  }
}