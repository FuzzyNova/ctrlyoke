{
  "compilerOptions": {
    "module": "node20",
    "target": "ES2022",
    "outDir": "out",
    "lib": ["ES2022"],
    "types": ["node"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false
  },
  "exclude": [
    "node_modules",
    "out",
    "dist",
    ".vscode-test",
    "manual-test",
    "src/ui/webview-react",
    "landing",
    "docs",
    "netlify"
  ]
}
