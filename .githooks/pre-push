#!/bin/sh
# Local fast gate for `main`-as-trunk. Runs typecheck/lint/test:ui/test:packaging
# before a push reaches the remote. Never runs test:harness (spends real money).
#
# Installed via: git config core.hooksPath .githooks
# (repo-shared config -- applies to every worktree, but each worktree needs its
# own `npm ci` before this hook can run there.)
#
# Skipped entirely when every changed file in the push is under dev/**, docs/**,
# or matches *.md -- a plan/docs commit shouldn't pay for the full suite.

zero_sha="0000000000000000000000000000000000000000"
any_relevant_change=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero_sha" ] && continue # deleting a ref -- nothing to check

	if [ "$remote_sha" = "$zero_sha" ]; then
		# New branch/ref on the remote -- diff against main's merge-base instead
		# of the all-zero placeholder.
		base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "$local_sha")
		range="$base..$local_sha"
	else
		range="$remote_sha..$local_sha"
	fi

	changed=$(git diff --name-only "$range")
	[ -z "$changed" ] && continue

	relevant=$(echo "$changed" | grep -v -E '^(dev/|docs/)' | grep -v -E '\.md$')
	if [ -n "$relevant" ]; then
		any_relevant_change=1
	fi
done

if [ "$any_relevant_change" -eq 0 ]; then
	echo "pre-push: only dev/**, docs/**, or *.md changed -- skipping the fast gate."
	exit 0
fi

if [ ! -e "node_modules/.bin/tsc" ]; then
	echo "pre-push: node_modules looks missing or incomplete in this worktree." >&2
	echo "Run 'npm ci' here first, then push again." >&2
	exit 1
fi

run_step() {
	echo "pre-push: running $1..."
	if ! npm run "$1" --silent; then
		echo "pre-push: '$1' failed -- push blocked. Fix the issue above and try again." >&2
		echo "(Use --no-verify to bypass in a genuine emergency -- not routinely.)" >&2
		exit 1
	fi
}

run_step typecheck
run_step lint
run_step test:ui
run_step test:packaging

echo "pre-push: all checks passed."
exit 0
