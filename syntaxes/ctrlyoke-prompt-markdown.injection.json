{
  "$comment": "AUTO-GENERATED by scripts/generate-prompt-markdown-injection.mjs from WORKFLOW_TEXT_FIELDS. Do not edit by hand.",
  "scopeName": "ctrlyoke.prompt-markdown.injection",
  "injectionSelector": "L:source.yaml -comment -string.quoted",
  "patterns": [
    {
      "include": "#prompt-block-scalar"
    },
    {
      "include": "#prompt-inline"
    }
  ],
  "repository": {
    "prompt-block-scalar": {
      "begin": "(?<=\\bpassRetryPrompt: |\\bprompt: |\\bretryPrompt: )(?:(\\|)|(>))([1-9])?([-+])?(.*\\n?)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.flow.block-scalar.literal.yaml"
        },
        "2": {
          "name": "keyword.control.flow.block-scalar.folded.yaml"
        },
        "3": {
          "name": "constant.numeric.indentation-indicator.yaml"
        },
        "4": {
          "name": "storage.modifier.chomping-indicator.yaml"
        },
        "5": {
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "match": "\\S.*",
              "name": "invalid.illegal.expected-comment-or-newline.yaml"
            }
          ]
        }
      },
      "end": "^(?=\\S)|(?!\\G)(?![ \\t]*$)",
      "name": "meta.scalar.yaml",
      "patterns": [
        {
          "begin": "(?:^|\\G)([ ]+)(?! )",
          "while": "(?:^|\\G)(?>\\1|(?=[ \\t]*$))",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.indentation.yaml"
            }
          },
          "contentName": "string.unquoted.block.yaml meta.embedded.block.markdown",
          "patterns": [
            {
              "include": "#fenced-code"
            },
            {
              "include": "#heading"
            },
            {
              "include": "text.html.markdown#inline"
            }
          ]
        }
      ]
    },
    "comment": {
      "match": "(?:^|[ \\t]+)(#).*$",
      "name": "comment.line.number-sign.yaml",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.yaml"
        }
      }
    },
    "prompt-inline": {
      "begin": "(?<=\\bpassRetryPrompt:|\\bprompt:|\\bretryPrompt:)([ \\t]++)(?![|>\"'#&*!\\[{%@`\\s])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.whitespace.separator.yaml"
        }
      },
      "end": "$",
      "contentName": "string.unquoted.plain.out.yaml meta.embedded.inline.markdown",
      "patterns": [
        {
          "include": "text.html.markdown#inline"
        }
      ]
    },
    "heading": {
      "match": "(?:^|\\G)(#{1,6})(\\s+)(.*?)(\\s+#+\\s*)?$",
      "name": "markup.heading.markdown",
      "captures": {
        "1": {
          "name": "punctuation.definition.heading.markdown"
        },
        "3": {
          "name": "entity.name.section.markdown"
        }
      }
    },
    "fenced-code": {
      "patterns": [
        {
          "include": "text.html.markdown#fenced_code_block"
        }
      ]
    }
  }
}
