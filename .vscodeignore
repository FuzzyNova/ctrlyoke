# Allowlist the VSIX contents. VSCE processes negated patterns globally, so
# keep negations specific instead of re-including entire parent directories.
**

# Marketplace metadata and user-facing docs.
!package.json
!README.md
!readme.md
!CHANGELOG.md
!changelog.md
!LICENSE
!LICENSE.md
!LICENSE.txt
!THIRD_PARTY_NOTICES.md
!QUICK_START.md

# Extension icons referenced from package.json contributions.
!images/icon.png
!images/ctrlyoke-icon.svg
!images/ctrlyoke-sidebar-icon.svg
!images/ctrlyoke-icon-light.svg
!images/ctrlyoke-icon-dark.svg
!images/ctrlyoke-icon-color.png

# Getting Started walkthrough step content.
!walkthroughs/**

# Bundled extension and MCP server entrypoints.
# cli.js is released as a standalone npm package, not bundled with the VSIX.
!out/extension.js
!out/mcp-server.js
!out/historySearchRebuildWorker.js
!out/historySearchMatcherWorker.js

# Runtime assets copied by the production build.
!out/templates/**
!out/schemas/**
!out/scripts/*.js
!out/scripts/ctrlyoke-opencode-plugin.ts
!out/server/standalone-shim.js
!out/server/ctrlyoke-service-worker.js
!out/server/hosted-error-page.html
!out/ui/webview-scripts/*.js
!out/ui/webview-react/index.html
!out/ui/webview-react/*.css
!out/ui/webview-react/*.js
!out/ui/webview-react/*.svg
# Notification badge served statically by /ctrlyoke-icon-color.png (SERVICE_WORKER's
# FAVICON_PNG path has no dynamic route override, unlike icon.png/apple-touch-icon.png).
!out/ui/webview-react/ctrlyoke-icon-color.png
!out/ui/webview-react/assets/*.css
!out/ui/webview-react/assets/*.js
!out/ui/webview-react/codicons/**
!out/ui/webview-react/dictionaries/**/*.aff
!out/ui/webview-react/dictionaries/**/*.dic
!out/runtime-deps/**

# Runtime native dependency. Other dependencies are bundled by esbuild.
!node_modules/node-pty/**
!node_modules/node-addon-api/**
