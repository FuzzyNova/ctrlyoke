.vscode/**
.vscode-test/**

# Exclude all build output, then whitelist only what the extension needs
out/**
!out/extension.js
!out/mcp-server.js
!out/templates/**
!out/schemas/**
!out/ui/**
!out/scripts/**

# Dependencies and source
node_modules/**
!node_modules/
!node_modules/node-pty/
!node_modules/node-pty/**
!node_modules/node-addon-api/
!node_modules/node-addon-api/**
src/**

# TypeScript / build config
.gitignore
.yarnrc
esbuild.js
vsc-extension-quickstart.md
**/tsconfig.json
**/eslint.config.mjs
**/*.map
**/*.ts
**/.vscode-test.*

# Development files
docs/**
manual-test/**
logs/**
prompts/**
.github/**
DEVELOPMENT.md
images/README.md

# Source schemas (compiled copies ship in out/schemas/**)
schemas/**

# Root-level build scripts (not needed at runtime)
scripts/**

# Archive of old vanilla-JS webview (replaced by React)
archive/**

# Contributor/AI tooling files
AGENTS.md
CLAUDE.md
CHORES.md

# Prettier config
.prettierrc.json
.prettierignore

# FlightPath workspace data (user-generated at runtime, not part of extension)
.flightpath/**
