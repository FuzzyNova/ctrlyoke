{
  "prompts": [
    {
      "prompt": "Example 1: Only retryPrompt specified (uses default maxRetries from settings, default: 3)",
      "endCondition": {
        "script": "check_documentation.js",
        "returns": "complete",
        "retryPrompt": "Custom retry message: {scriptOutput}"
      }
    },
    {
      "prompt": "Example 2: Only maxRetries specified (uses default retryPrompt from settings)",
      "endCondition": {
        "script": "check_documentation.js",
        "returns": "complete",
        "maxRetries": 5
      }
    },
    {
      "prompt": "Example 3: Both specified (uses explicit values, no defaults)",
      "endCondition": {
        "script": "check_documentation.js",
        "returns": "complete",
        "maxRetries": 2,
        "retryPrompt": "Both custom: attempt {retryCount}/{maxRetries}\n{scriptOutput}"
      }
    },
    {
      "prompt": "Example 4: Neither specified (no retries)",
      "endCondition": {
        "script": "check_documentation.js",
        "returns": "complete"
      }
    },
    {
      "prompt": "Example 5: Unlimited retries with custom prompt",
      "endCondition": {
        "script": "check_documentation.js",
        "returns": "complete",
        "maxRetries": -1,
        "retryPrompt": "Keep trying forever: {scriptOutput}"
      }
    },
    {
      "prompt": "Example 6: Explicit zero retries (overrides default even with retryPrompt)",
      "endCondition": {
        "script": "check_documentation.js",
        "returns": "complete",
        "maxRetries": 0,
        "retryPrompt": "This won't be used because maxRetries is 0"
      }
    }
  ]
}
