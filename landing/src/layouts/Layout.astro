---
import Cta from "../components/Cta.astro";
import { LAUNCHED, MARKETPLACE_URL } from "../config";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "ctrlyoke is one interface for every AI coding harness — a shared way to prompt, steer, automate, and revisit work across Claude Code, Codex, Copilot CLI, and more.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/ctrlyoke-icon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="ctrlyoke" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Pre-launch: no index until ctrlyoke ships (controlled by LAUNCHED in src/config.ts). */}
    {!LAUNCHED && <meta name="robots" content="noindex" />}
  </head>
  <body class="bg-brand-950 text-slate-100 antialiased">
    {
      !LAUNCHED && (
        <a
          href="https://github.com/FuzzyNova/ctrlyoke"
          class="block border-b border-sky-400/20 bg-sky-400/10 px-4 py-2 text-center text-sm text-sky-200 hover:bg-sky-400/15 transition-colors"
        >
          🚧 ctrlyoke is in active development and not yet released — follow progress on GitHub →
        </a>
      )
    }
    <header class="sticky top-0 z-50 border-b border-white/5 bg-brand-950/90 backdrop-blur-sm">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/ctrlyoke-icon.svg" alt="" class="h-8 w-8" />
          <span class="wordmark wordmark--flush-left text-2xl">CTRLYOKE</span>
        </a>
        <div class="hidden items-center gap-6 text-sm text-slate-400 md:flex">
          <a href="/docs/" class="hover:text-white transition-colors">Docs</a>
          <a href="/pricing/" class="hover:text-white transition-colors">Pricing</a>
          <a href="/trust/" class="hover:text-white transition-colors">Trust</a>
          <a href="https://github.com/FuzzyNova/ctrlyoke" class="hover:text-white transition-colors">GitHub</a>
        </div>
        <Cta
          href={MARKETPLACE_URL}
          class="rounded-md bg-sky-400 px-4 py-1.5 text-sm font-semibold text-brand-950 hover:bg-sky-300 transition-colors"
        >
          Install for VS Code
        </Cta>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-white/5 bg-brand-900/40 py-12">
      <div class="mx-auto max-w-6xl px-6">
        <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
          <div class="flex flex-col gap-3">
            <a href="/" class="flex items-center gap-2">
              <img src="/ctrlyoke-icon.svg" alt="" class="h-7 w-7" />
              <span class="wordmark wordmark--flush-left text-xl">CTRLYOKE</span>
            </a>
            <p class="text-sm text-slate-500">One workflow engine for every AI coding CLI.</p>
            <p class="text-sm text-slate-500">By <a href="https://fuzzno.com" class="hover:text-slate-300 transition-colors">Fuzzy Nova LLC</a>.</p>
          </div>
          <div class="grid grid-cols-2 gap-8 text-sm md:grid-cols-3">
            <div class="flex flex-col gap-3">
              <span class="font-medium text-slate-300">Product</span>
              <a href="/pricing/" class="text-slate-500 hover:text-slate-300 transition-colors">Pricing</a>
              <a href="/docs/" class="text-slate-500 hover:text-slate-300 transition-colors">Docs</a>
              <a href="/docs/guide/" class="text-slate-500 hover:text-slate-300 transition-colors">Getting started</a>
            </div>
            <div class="flex flex-col gap-3">
              <span class="font-medium text-slate-300">Resources</span>
              <a href="https://github.com/FuzzyNova/ctrlyoke" class="text-slate-500 hover:text-slate-300 transition-colors">GitHub</a>
              <a href="https://github.com/FuzzyNova/ctrlyoke/issues" class="text-slate-500 hover:text-slate-300 transition-colors">Issues</a>
              <a href="mailto:support@ctrlyoke.dev" class="text-slate-500 hover:text-slate-300 transition-colors">Support</a>
            </div>
            <div class="flex flex-col gap-3">
              <span class="font-medium text-slate-300">Legal</span>
              <a href="/terms/" class="text-slate-500 hover:text-slate-300 transition-colors">Terms</a>
              <a href="/privacy/" class="text-slate-500 hover:text-slate-300 transition-colors">Privacy</a>
              <a href="/enterprise-terms/" class="text-slate-500 hover:text-slate-300 transition-colors">Enterprise Terms</a>
              <a href="/dpa/" class="text-slate-500 hover:text-slate-300 transition-colors">DPA</a>
              <a href="/trust/" class="text-slate-500 hover:text-slate-300 transition-colors">Trust & Security</a>
            </div>
          </div>
        </div>
        <div class="mt-10 border-t border-white/5 pt-8 text-sm text-slate-600">
          Copyright &copy; {new Date().getFullYear()} Fuzzy Nova LLC. All rights reserved.
        </div>
      </div>
    </footer>
  </body>
</html>
