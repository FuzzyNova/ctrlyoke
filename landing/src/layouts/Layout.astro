---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "FlightPath orchestrates AI coding assistants through structured, step-by-step workflows — validated, resumable, and hands-free.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/flightpath-icon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="FlightPath" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-brand-950 text-slate-100 antialiased">
    <header class="fixed top-0 left-0 right-0 z-50 border-b border-white/5 bg-brand-950/90 backdrop-blur-sm">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href="/" class="flex items-center gap-2.5 font-semibold text-white">
          <img src="/flightpath-icon.svg" alt="" class="h-7 w-7" />
          FlightPath
        </a>
        <div class="hidden items-center gap-6 text-sm text-slate-400 md:flex">
          <a href="/docs/" class="hover:text-white transition-colors">Docs</a>
          <a href="/pricing/" class="hover:text-white transition-colors">Pricing</a>
          <a href="https://github.com/FuzzyNova/flightpath" class="hover:text-white transition-colors">GitHub</a>
        </div>
        <a
          href="https://marketplace.visualstudio.com/items?itemName=fuzzynova.flightpath"
          class="rounded-md bg-sky-400 px-4 py-1.5 text-sm font-semibold text-brand-950 hover:bg-sky-300 transition-colors"
        >
          Install for VS Code
        </a>
      </nav>
    </header>

    <main class="pt-16">
      <slot />
    </main>

    <footer class="border-t border-white/5 bg-brand-900/40 py-12">
      <div class="mx-auto max-w-6xl px-6">
        <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
          <div class="flex flex-col gap-3">
            <a href="/" class="flex items-center gap-2 font-semibold text-white">
              <img src="/flightpath-icon.svg" alt="" class="h-6 w-6" />
              FlightPath
            </a>
            <p class="text-sm text-slate-500">AI workflow automation for VS Code.</p>
            <p class="text-sm text-slate-500">By <a href="https://fuzzno.com" class="hover:text-slate-300 transition-colors">Fuzzy Nova</a>.</p>
          </div>
          <div class="grid grid-cols-2 gap-8 text-sm md:grid-cols-3">
            <div class="flex flex-col gap-3">
              <span class="font-medium text-slate-300">Product</span>
              <a href="/pricing/" class="text-slate-500 hover:text-slate-300 transition-colors">Pricing</a>
              <a href="/docs/" class="text-slate-500 hover:text-slate-300 transition-colors">Docs</a>
              <a href="/docs/guide/" class="text-slate-500 hover:text-slate-300 transition-colors">Getting started</a>
            </div>
            <div class="flex flex-col gap-3">
              <span class="font-medium text-slate-300">Resources</span>
              <a href="https://github.com/FuzzyNova/flightpath" class="text-slate-500 hover:text-slate-300 transition-colors">GitHub</a>
              <a href="https://github.com/FuzzyNova/flightpath/issues" class="text-slate-500 hover:text-slate-300 transition-colors">Issues</a>
              <a href="mailto:support@flightpath.dev" class="text-slate-500 hover:text-slate-300 transition-colors">Support</a>
            </div>
            <div class="flex flex-col gap-3">
              <span class="font-medium text-slate-300">Legal</span>
              <a href="/terms/" class="text-slate-500 hover:text-slate-300 transition-colors">Terms</a>
              <a href="/privacy/" class="text-slate-500 hover:text-slate-300 transition-colors">Privacy</a>
            </div>
          </div>
        </div>
        <div class="mt-10 border-t border-white/5 pt-8 text-sm text-slate-600">
          Copyright &copy; {new Date().getFullYear()} Fuzzy Nova. All rights reserved.
        </div>
      </div>
    </footer>
  </body>
</html>
