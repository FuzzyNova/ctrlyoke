---
import Layout from "../layouts/Layout.astro";
import Cta from "../components/Cta.astro";
import VsCodeIcon from "../components/VsCodeIcon.astro";
import HarnessDeck from "../components/HarnessDeck.astro";
import DemoVideo from "../components/DemoVideo.astro";
import ScreenshotTabs from "../components/ScreenshotTabs.astro";
import { LAUNCHED, MARKETPLACE_URL } from "../config";
// Canonical screenshots live at repo-root images/screenshots/, not duplicated into
// landing/public/ — see "Screenshot assets" in .github/copilot-instructions.md.
// The AV1/H.264/poster sets come from `npm run media -- <shot>` (media/README.md).
import heroAv1 from "../../../images/screenshots/hero-av1-2700x1800.mp4";
import heroH264 from "../../../images/screenshots/hero-h264-1350x900.mp4";
import heroPoster from "../../../images/screenshots/hero-poster-2700x1800.webp";
import visualOrYamlAv1 from "../../../images/screenshots/visual-or-yaml-av1-2560x1600.mp4";
import visualOrYamlH264 from "../../../images/screenshots/visual-or-yaml-h264-1280x800.mp4";
import visualOrYamlPoster from "../../../images/screenshots/visual-or-yaml-poster-2560x1600.webp";
import promptEditorAv1 from "../../../images/screenshots/prompt-editor-av1-1920x1280.mp4";
import promptEditorH264 from "../../../images/screenshots/prompt-editor-h264-960x640.mp4";
import promptEditorPoster from "../../../images/screenshots/prompt-editor-poster-1920x1280.webp";
import takeControlVideo from "../../../images/screenshots/ctrlyoke-take-control-1080p.mp4";
import historyWorkflows from "../../../images/screenshots/history-workflows-2560x1600.png";
import historySearch from "../../../images/screenshots/history-search-2560x1600.png";
import historyReopenedRun from "../../../images/screenshots/history-reopened-run-2560x1600.png";
import viewerReferences from "../../../images/screenshots/workspace-viewer-references-2560x1600.png";
import viewerCommit from "../../../images/screenshots/workspace-viewer-commit-2560x1600.png";
import undoOutput from "../../../images/screenshots/file-changes-output-undo-2560x1600.png";
import undoWorkflow from "../../../images/screenshots/file-changes-workflow-2560x1600.png";

// `npm run media -- history`, over demo-app's recorded run history.
const historyShots = [
  {
    img: historyWorkflows,
    tab: "Every workflow",
    caption:
      "Every workflow you've run, with its harness, tokens, cost, and run count. Star the ones you come back to and they stay on top.",
    alt: "The ctrlyoke workflow list open over a six-step workflow: favorited workflows with run counts, and runs on Claude Code, Codex, Copilot CLI, OpenCode, Qwen Code, and Antigravity",
  },
  {
    img: historySearch,
    tab: "Search every session",
    caption:
      "Search prompts, answers, commands, and diffs across every run and every harness. Here, how five agents handled the same rate-limiting task.",
    alt: "ctrlyoke history search for “per IP”, filtered to responses, listing matches from the Claude Code, Qwen Code, and OpenCode runs of the same task",
  },
  {
    img: historyReopenedRun,
    tab: "Pick up where you left off",
    caption:
      "Open a result to land in that run with every match highlighted. Resume its session, or run the workflow again.",
    alt: "An OpenCode run from six weeks earlier reopened from a search result, its output with each “per IP” highlighted and the find bar showing 1 of 2",
  },
];

// `npm run media -- workspace-viewer`: demo-app with an agent's changes uncommitted.
const viewerShots = [
  {
    img: viewerReferences,
    tab: "Edit with language features",
    caption:
      "Browse and edit files with syntax highlighting and a real language server: Go to Definition, Find All References, Rename Symbol, and Format Document.",
    alt: "The ctrlyoke workspace viewer in a browser: a TypeScript file open in the editor, with a References panel listing five uses of normalizeTag in two files",
  },
  {
    img: viewerCommit,
    tab: "Review and commit",
    caption:
      "Review what the agent changed file by file, stage it, and commit, with the branch history alongside.",
    alt: "The workspace viewer's Source Control tab: five staged files, a diff of notes.ts, a commit message ready to commit, and the branch's commit history",
  },
];

// `npm run media -- file-changes`: the hero run replayed with its file snapshots.
const undoShots = [
  {
    img: undoOutput,
    tab: "Undo one edit",
    caption:
      "Every file edit in the output has its own diff and Undo button, whichever harness made it. Here, Antigravity's fix during review.",
    alt: "The ctrlyoke dashboard after a six-step workflow: in the output, Antigravity's “Edited notesStore.ts” with its diff expanded and an Undo button",
  },
  {
    img: undoWorkflow,
    tab: "Review the whole run",
    caption:
      "See every file a workflow changed in one place, with the steps that touched each one, and undo just the files you pick.",
    alt: "The Workflow changes dialog for a six-step run: notesStore.ts and notes.ts selected, each listing the steps that changed it, a side-by-side diff of notes.ts, and an Undo 2 files button",
  },
];

// One per reference kind the prompt editor clip shows. Each accent is that kind's
// SYMBOL_ICON_COLORS entry (src/ui/webview-react/utils/atomicReferences.ts),
// resolved from VS Code's default dark theme.
const references = [
  { token: "@src/routes/", body: "Files and folders", accent: "#e0b97f" }, // folder: charts-yellow
  { token: "#sym:normalizeTag", body: "Symbols and line selections", accent: "#b180d7" }, // symbol-function
  { token: "~0f2072a", body: "Commits, staged and working-tree diffs", accent: "#86cf86" }, // git-commit: charts-green
  { token: "$previous", body: "Output from earlier steps", accent: "#ef8773" }, // book: charts-red
  { token: "!API_TOKEN", body: "Secrets, passed as environment variables, never written into the prompt", accent: "#ad80d7" }, // key: charts-purple
  { token: "/skill:commit", body: "Skills and MCP servers, per step", accent: "#cd861a" }, // tools: charts-orange
];

const features = [
  {
    title: "Native terminal, structured control",
    body: "Watch and steer the real interactive CLI in an embedded terminal while ctrlyoke builds a searchable record beside it.",
    icon: ">_",
  },
  {
    title: "Checks that use your own scripts",
    body: "Pre- and end-conditions gate each step with the scripts your project already trusts — continue, retry, skip, or stop.",
    icon: "✓",
  },
  {
    title: "Agents, skills and MCP servers, set up once",
    body: "Manage agents, skills, MCP servers, and hooks once, then reuse them across every harness you run.",
    icon: "🧰",
  },
];

const byoCli = [
  {
    title: "You install it and sign in to it",
    body: "ctrlyoke never signs in for you, and never reads or stores your harness login.",
  },
  {
    title: "ctrlyoke remembers the flags",
    body: "Each CLI's invocation, session resume, permission modes, and MCP and hook config are handled for you.",
  },
  {
    title: "Your plan and its terms still apply",
    body: "ctrlyoke adds an editor and a workflow engine around the agent. The agent itself, and what you pay for it, stay the same.",
  },
];

const steps = [
  {
    number: "1",
    title: "Prompt",
    body: "Reference files, symbols, selections, and Git changes right in the editor — with completions, validation, and token estimates.",
  },
  {
    number: "2",
    title: "Steer",
    body: "Watch and drive the native terminal directly, or let a structured workflow carry the step forward for you.",
  },
  {
    number: "3",
    title: "Automate",
    body: "Chain prompts and scripts into a validated workflow. Retry on real output, mix harnesses, run several at once.",
  },
  {
    number: "4",
    title: "Revisit",
    body: "Every run lands in a searchable, diffable history you can replay, export, or run again.",
  },
];
---

<Layout
  title="ctrlyoke — One workflow engine for every CLI coding agent"
  description="A VS Code extension for CLI coding agents. Send a coding agent one prompt, or chain prompts and scripts into a workflow that checks its own work. Every session stays searchable in one dashboard."
>

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-white/5 bg-brand-950 px-6 pb-16 pt-8 md:pb-24 md:pt-10">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-10%,rgba(14,83,128,0.3),transparent)]"></div>
    <div class="relative mx-auto max-w-4xl text-center">
      <img
        src="/ctrlyoke-icon.svg"
        alt=""
        class="mx-auto mb-3 h-24 w-24 drop-shadow-[0_8px_24px_rgba(57,148,188,0.35)] md:h-32 md:w-32"
      />
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-sky-400/20 bg-sky-400/5 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-sky-400">
        <img src="/icons/vscode.svg" alt="" class="h-3.5 w-3.5" />
        VS Code Extension
      </div>
      <h1 class="text-5xl font-bold leading-tight tracking-tight text-white md:text-6xl">
        One workflow engine for<br />every CLI coding agent
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-400 md:text-xl">
        Send a coding agent one prompt, or chain prompts and scripts into a workflow that checks
        its own work. Every session stays searchable in one VS Code dashboard.
      </p>
    </div>
    <div class="relative mx-auto mt-10 max-w-6xl">
      <DemoVideo
        av1={heroAv1}
        h264={heroH264}
        poster={heroPoster}
        width={1350}
        height={900}
        label="ctrlyoke running a multi-step workflow across several CLI coding agents, with live output and the output minimap"
      />
    </div>
    <div class="relative mx-auto mt-10 max-w-4xl text-center">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-sky-400/20 bg-sky-400/5 px-4 py-1.5 text-sm text-sky-400">
        <span class="h-1.5 w-1.5 rounded-full bg-sky-400"></span>
        Free to install · Pro adds remote access
      </div>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <Cta
          href={MARKETPLACE_URL}
          class="inline-flex items-center gap-2 rounded-lg bg-sky-400 px-6 py-3 font-semibold text-brand-950 hover:bg-sky-300 transition-colors"
        >
          <VsCodeIcon />
          Install for VS Code
        </Cta>
        <a
          href="/docs/"
          class="inline-flex items-center gap-2 rounded-lg border border-white/10 px-6 py-3 font-semibold text-slate-300 hover:border-white/20 hover:text-white transition-colors"
        >
          Read the docs
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="border-b border-white/5 bg-brand-900/20 px-6 py-10">
    <div class="mx-auto max-w-6xl">
      <h2 class="mb-6 text-center text-xs font-semibold uppercase tracking-widest text-sky-400">How it works</h2>
      <ol class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s) => (
          <li class="flex items-start gap-3">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-sky-400/30 bg-sky-400/10 text-sm font-bold text-sky-400">
              {s.number}
            </span>
            <div>
              <h3 class="font-semibold text-white">{s.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-slate-400">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- One dashboard, six harnesses -->
  <section class="border-b border-white/5 px-6 py-20">
    <div class="mx-auto max-w-4xl">
      <div class="mb-10 text-center">
        <h2 class="text-3xl font-bold text-white md:text-4xl">One dashboard, six harnesses</h2>
        <p class="mt-3 text-slate-400">
          Each CLI coding agent you install and run through ctrlyoke is a <em>harness</em>.
          ctrlyoke calls it for you, so you can change harnesses, not habits.
        </p>
      </div>
      <HarnessDeck />
    </div>
  </section>

  <!-- Bring your own CLI -->
  <section class="border-b border-white/5 px-6 py-20">
    <div class="mx-auto max-w-4xl">
      <div class="mb-10 text-center">
        <h2 class="text-3xl font-bold text-white md:text-4xl">Your CLI and your account. ctrlyoke just calls it.</h2>
        <p class="mx-auto mt-3 max-w-2xl text-slate-400">
          ctrlyoke doesn't replace Claude Code, Codex, or Copilot CLI. It launches the copy you
          installed, signed in the way you signed it in.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {byoCli.map((item) => (
          <div class="rounded-xl border border-white/8 bg-brand-900/40 p-6">
            <h3 class="mb-2 font-semibold text-white">{item.title}</h3>
            <p class="text-sm leading-relaxed text-slate-400">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Build visually or edit as YAML -->
  <section class="border-b border-white/5 bg-brand-900/30 px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12 text-center">
        <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">Build visually, or edit as YAML</h2>
        <p class="mx-auto max-w-2xl text-slate-400">
          Drag steps into parallel groups and pick a harness and model for each one, or open the
          same workflow as a file and type it with completions. Either way, it's plain YAML or JSON
          that lives in your repo.
        </p>
      </div>
      <DemoVideo
        av1={visualOrYamlAv1}
        h264={visualOrYamlH264}
        poster={visualOrYamlPoster}
        width={1280}
        height={800}
        label="On the left, dragging a step into a parallel group in the ctrlyoke dashboard and setting its harness and model; on the right, adding the same step to the workflow's YAML file with completions"
      />
      <div class="mt-4 grid grid-cols-2 text-sm text-slate-500">
        <span class="text-center">The dashboard's step list</span>
        <span class="text-center">The same workflow as YAML</span>
      </div>
    </div>
  </section>

  <!-- Prompt editor -->
  <section class="border-b border-white/5 px-6 py-24">
    <div class="mx-auto max-w-4xl">
      <div class="mb-12 text-center">
        <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">A prompt language for your whole project</h2>
        <p class="mx-auto max-w-2xl text-slate-400">
          Reference files, symbols, commits, earlier steps, secrets, skills, and MCP servers right
          in the prompt. Completions find each one as you type, and ctrlyoke turns them into real
          context before the harness sees the prompt.
        </p>
      </div>
      <DemoVideo
        av1={promptEditorAv1}
        h264={promptEditorH264}
        poster={promptEditorPoster}
        width={960}
        height={640}
        label="Typing a prompt in the ctrlyoke prompt editor: a code selection, a symbol, a file, a folder, an earlier step's output, a commit, a secret, and a skill, each picked from completions and shown as a chip"
      />
      <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
        {references.map((r) => (
          <div class="flex flex-col items-start gap-2 rounded-xl border border-white/8 bg-brand-900/40 p-4">
            <code class="reference-chip font-mono text-sm" style={`--reference-accent: ${r.accent}`}>{r.token}</code>
            <p class="text-sm text-slate-400">{r.body}</p>
          </div>
        ))}
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-slate-400">
        Plus spell check, image paste, token estimates that include the attached context, and a
        warning before you run a reference that won't resolve.{" "}
        <a href="/docs/workflows/context-files" class="text-sky-400 hover:text-sky-300 transition-colors">See the full reference syntax.</a>
      </p>
    </div>
  </section>

  <!-- Run history -->
  <section class="border-b border-white/5 bg-brand-900/30 px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 text-center">
        <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">Every session, searchable</h2>
        <p class="mx-auto max-w-2xl text-slate-400">
          ctrlyoke keeps every run on every harness: the prompts, the answers, the commands, and
          the diffs. Search all of it at once, reopen any run, and continue its session or run it
          again.
        </p>
      </div>
      <ScreenshotTabs id="history" shots={historyShots} width={1280} height={800} />
    </div>
  </section>

  <!-- Undo -->
  <section class="border-b border-white/5 px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 text-center">
        <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">Every result, with undo</h2>
        <p class="mx-auto max-w-2xl text-slate-400">
          Whichever harness ran the step, its file edits show up the same way: a diff for each
          one, and undo for a single edit, a single file, or everything a workflow changed.
        </p>
      </div>
      <ScreenshotTabs id="undo" shots={undoShots} width={1280} height={800} />
      <p class="mx-auto mt-6 max-w-2xl text-center text-sm text-slate-400">
        <a href="/docs/guide/file-changes" class="text-sky-400 hover:text-sky-300 transition-colors">See how undo works.</a>
      </p>
    </div>
  </section>

  <!-- Workspace viewer -->
  <section class="border-b border-white/5 bg-brand-900/30 px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 text-center">
        <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">Your project, in any browser</h2>
        <p class="mx-auto max-w-2xl text-slate-400">
          The browser dashboard comes with a workspace viewer: a code editor with language
          servers, search, diffs, and Git. Check what an agent did and commit it without a VS
          Code window.
        </p>
      </div>
      <ScreenshotTabs id="workspace-viewer" shots={viewerShots} width={1280} height={800} />
      <p class="mx-auto mt-6 max-w-2xl text-center text-sm text-slate-400">
        <a href="/docs/guide/workspace-viewer" class="text-sky-400 hover:text-sky-300 transition-colors">See what the workspace viewer can do.</a>
      </p>
    </div>
  </section>

  <!-- Features -->
  <section class="border-b border-white/5 px-6 py-24">
    <div class="mx-auto max-w-4xl">
      <div class="mb-16 text-center">
        <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">
          The same tools, whichever harness runs
        </h2>
        <p class="mx-auto max-w-xl text-slate-400">
          The terminal, validation and your agents, skills and MCP servers work the same way on
          all six harnesses.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-xl border border-white/8 bg-brand-900/40 p-6 hover:border-sky-400/20 transition-colors">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-sky-400/10 font-mono text-sky-400">
              {f.icon}
            </div>
            <h3 class="mb-2 font-semibold text-white">{f.title}</h3>
            <p class="text-sm leading-relaxed text-slate-400">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pro: code from your phone -->
  <section class="border-b border-white/5 px-6 py-24">
    <div class="mx-auto max-w-4xl">
      <div class="overflow-hidden rounded-2xl border border-sky-400/15 bg-gradient-to-br from-brand-800 to-brand-900 p-6 sm:p-10 md:p-14">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-sky-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-sky-400">
          ctrlyoke Pro
        </div>
        <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">Code from your phone</h2>
        <p class="mb-8 max-w-2xl text-lg text-slate-300">
          Pro unlocks the remote dashboard. Scan the QR code and take control of a workflow
          running on your PC, even mid-step, from any browser or phone that can reach it: across
          your home or office network, or from anywhere over your own VPN.{" "}
          <a href="/docs/pro/remote-access" class="text-sky-400 hover:text-sky-300 transition-colors">See how to connect from anywhere.</a>
        </p>
        <div class="mb-10 overflow-hidden rounded-xl border border-white/10 shadow-2xl shadow-black/50">
          <video
            src={takeControlVideo}
            width={1920}
            height={1080}
            autoplay
            muted
            loop
            playsinline
            aria-label="Scanning a QR code on a phone, then taking control of a ctrlyoke workflow running in VS Code"
            class="w-full"
          />
        </div>
        <div class="mb-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {[
            "Remote & LAN browser dashboard",
            "LAN IP binding & QR-to-phone access",
            "HTTPS with custom TLS certificates",
            "Push notifications (browser + mobile)",
            "Air-gapped offline activation",
            "14-day free trial — no card required",
          ].map((item) => (
            <div class="flex items-center gap-2.5 text-sm text-slate-300">
              <svg class="h-4 w-4 shrink-0 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
              {item}
            </div>
          ))}
        </div>
        <a
          href="/pricing/"
          class="inline-flex items-center gap-2 rounded-lg bg-sky-400 px-6 py-3 font-semibold text-brand-950 hover:bg-sky-300 transition-colors"
        >
          See pricing
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Install CTA -->
  <section class="px-6 py-24">
    <div class="mx-auto max-w-2xl text-center">
      <span class="wordmark mb-6 inline-block text-3xl md:text-4xl">CTRLYOKE</span>
      <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">Install ctrlyoke</h2>
      <p class="mb-10 text-slate-400">
        Free for individuals and companies under $10M revenue and 250 employees. Pro is optional.
      </p>
      <div class="flex flex-col items-center gap-4">
        <Cta
          href={MARKETPLACE_URL}
          class="inline-flex items-center gap-2 rounded-lg bg-sky-400 px-8 py-3.5 font-semibold text-brand-950 hover:bg-sky-300 transition-colors"
        >
          <VsCodeIcon />
          Install for VS Code
        </Cta>
        {
          LAUNCHED && (
            <>
              <div class="flex items-center gap-3 text-sm text-slate-500">
                <span>or install the CLI</span>
              </div>
              <div class="rounded-lg border border-white/8 bg-brand-900 px-6 py-3 font-mono text-sm text-slate-300">
                npm install -g ctrlyoke
              </div>
              <p class="max-w-md text-sm text-slate-500">
                No VS Code? <code class="font-mono text-slate-400">ctrlyoke server</code> opens the
                same dashboard in your browser.
              </p>
            </>
          )
        }
      </div>
    </div>
  </section>

</Layout>
