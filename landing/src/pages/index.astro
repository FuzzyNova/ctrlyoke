---
import Layout from "../layouts/Layout.astro";
import Cta from "../components/Cta.astro";
import HarnessDeck from "../components/HarnessDeck.astro";
import { LAUNCHED, MARKETPLACE_URL } from "../config";

const harnesses = [
  { name: "Copilot CLI", icon: "/icons/harnesses/copilot-cli.svg" },
  { name: "Claude Code", icon: "/icons/harnesses/claude.svg" },
  { name: "Codex CLI", icon: "/icons/harnesses/codex.svg" },
  { name: "OpenCode", icon: "/icons/harnesses/opencode.svg" },
  { name: "Qwen Code", icon: "/icons/harnesses/qwen.svg" },
  { name: "Antigravity CLI", icon: "/icons/harnesses/antigravity.svg" },
];

const features = [
  {
    title: "Point at the context you mean",
    body: "Reference files, symbols, selections, Git changes, commits, and prior-step output — readable in the prompt, expanded before the harness sees it.",
    icon: "📎",
  },
  {
    title: "A prompt editor for real work",
    body: "Context-aware completions, reference validation, expanded-context token estimates, image paste, and spell check.",
    icon: "✎",
  },
  {
    title: "Build visually. Save as code.",
    body: "Compose and rearrange workflows in the dashboard, then keep the result as ordinary YAML or JSON that travels with the project.",
    icon: "🧩",
  },
  {
    title: "One reversible view of every result",
    body: "Normalized output, inline diffs, an output minimap, and undo/redo down to a single file — no matter which harness ran it.",
    icon: "⬛",
  },
  {
    title: "Native terminal, structured control",
    body: "Watch and steer the real interactive CLI in an embedded terminal while ctrlyoke builds a searchable record beside it.",
    icon: ">_",
  },
  {
    title: "Validation, not vibes",
    body: "Pre- and end-conditions gate each step with the scripts your project already trusts — continue, retry, skip, or stop.",
    icon: "✓",
  },
  {
    title: "Searchable, replayable history",
    body: "Find the prompt, command, diff, or answer you remember, then reopen and rerun the complete workflow around it.",
    icon: "🔍",
  },
  {
    title: "One place for your toolkit",
    body: "Manage agents, skills, MCP servers, and hooks once, then reuse them across every harness you run.",
    icon: "🧰",
  },
];

const steps = [
  {
    number: "1",
    title: "Prompt",
    body: "Reference files, symbols, selections, and Git changes right in the editor — with completions, validation, and token estimates.",
  },
  {
    number: "2",
    title: "Steer",
    body: "Watch and drive the native terminal directly, or let a structured workflow carry the step forward for you.",
  },
  {
    number: "3",
    title: "Automate",
    body: "Chain prompts and scripts into a validated workflow. Retry on real output, mix harnesses, run several at once.",
  },
  {
    number: "4",
    title: "Revisit",
    body: "Every run lands in a searchable, diffable history you can replay, export, or run again.",
  },
];
---

<Layout
  title="ctrlyoke — One interface for every AI coding harness"
  description="The better way to prompt, steer, automate, and revisit work across Claude Code, Codex, Copilot CLI, and more."
>

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-white/5 bg-brand-950 px-6 py-24 md:py-36">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-10%,rgba(14,83,128,0.3),transparent)]"></div>
    <div class="relative mx-auto max-w-4xl text-center">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-sky-400/20 bg-sky-400/5 px-4 py-1.5 text-sm text-sky-400">
        <span class="h-1.5 w-1.5 rounded-full bg-sky-400"></span>
        Free to install · Pro for power users
      </div>
      <h1 class="mb-6 text-5xl font-bold leading-tight tracking-tight text-white md:text-6xl">
        One interface for<br />every AI coding harness
      </h1>
      <p class="mx-auto mb-10 max-w-2xl text-lg text-slate-400 md:text-xl">
        The better way to prompt, steer, automate, and revisit work across Claude Code,
        Codex, Copilot CLI, and more.
      </p>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <Cta
          href={MARKETPLACE_URL}
          class="inline-flex items-center gap-2 rounded-lg bg-sky-400 px-6 py-3 font-semibold text-brand-950 hover:bg-sky-300 transition-colors"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.583.063a1.5 1.5 0 0 0-1.032.392L7.963 7.489 3.195 3.868a1 1 0 0 0-1.276.038L.32 5.256a1 1 0 0 0-.009 1.493L3.735 10 .311 13.251a1 1 0 0 0 .009 1.493l1.6 1.35a1 1 0 0 0 1.276.038l4.768-3.621 8.588 7.034c.307.254.692.39 1.094.392A1.5 1.5 0 0 0 19.1 19.44l2.401-11.304c.009-.04.014-.082.017-.123A1.5 1.5 0 0 0 20.069.473 1.5 1.5 0 0 0 17.583.063zm.38 3.304v13.266l-7.13-6.633 7.13-6.633z"/></svg>
          Install for VS Code
        </Cta>
        <a
          href="/docs/"
          class="inline-flex items-center gap-2 rounded-lg border border-white/10 px-6 py-3 font-semibold text-slate-300 hover:border-white/20 hover:text-white transition-colors"
        >
          Read the docs
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- One dashboard, six harnesses -->
  <section class="border-b border-white/5 px-6 py-20">
    <div class="mx-auto max-w-4xl">
      <p class="mb-10 text-center text-sm font-medium uppercase tracking-widest text-slate-500">
        One dashboard, six harnesses
      </p>
      <HarnessDeck />
    </div>
  </section>

  <!-- Workflow snippet -->
  <section class="border-b border-white/5 bg-brand-900/30 px-6 py-20">
    <div class="mx-auto max-w-4xl">
      <p class="mb-8 text-center text-sm font-medium uppercase tracking-widest text-slate-500">
        Build visually. This is the file underneath.
      </p>
      <div class="overflow-hidden rounded-xl border border-white/8 bg-brand-900">
        <div class="flex items-center gap-1.5 border-b border-white/5 px-4 py-3">
          <span class="h-3 w-3 rounded-full bg-red-500/60"></span>
          <span class="h-3 w-3 rounded-full bg-yellow-500/60"></span>
          <span class="h-3 w-3 rounded-full bg-green-500/60"></span>
          <span class="ml-2 text-xs text-slate-500">implement-feature.ctrlyoke.yaml</span>
        </div>
        <pre class="overflow-x-auto p-6 text-sm leading-relaxed"><code class="text-slate-300"><span class="text-sky-400">name</span><span class="text-slate-500">:</span> Implement auth service
<span class="text-sky-400">harness</span><span class="text-slate-500">:</span> claude-cli

<span class="text-sky-400">steps</span><span class="text-slate-500">:</span>
  <span class="text-slate-500">-</span> <span class="text-sky-400">prompt</span><span class="text-slate-500">:</span> <span class="text-slate-300">|</span>
      <span class="text-slate-400">Implement the UserAuth service in src/auth.ts.</span>
      <span class="text-slate-400">Use the interface defined in src/types/auth.ts.</span>
    <span class="text-sky-400">endCondition</span><span class="text-slate-500">:</span>
      <span class="text-sky-400">script</span><span class="text-slate-500">:</span> npm run typecheck <span class="text-slate-500">&&</span> npm test

  <span class="text-slate-500">-</span> <span class="text-sky-400">prompt</span><span class="text-slate-500">:</span> <span class="text-slate-300">|</span>
      <span class="text-slate-400">Write integration tests covering login, logout,</span>
      <span class="text-slate-400">and token refresh. Aim for 90% branch coverage.</span>
    <span class="text-sky-400">endCondition</span><span class="text-slate-500">:</span>
      <span class="text-sky-400">script</span><span class="text-slate-500">:</span> npm test -- --coverage --branches 90</code></pre>
      </div>
    </div>
  </section>

  <!-- Harness grid -->
  <section class="border-b border-white/5 px-6 py-20">
    <div class="mx-auto max-w-4xl text-center">
      <p class="mb-10 text-sm font-medium uppercase tracking-widest text-slate-500">
        One consistent interface across supported harnesses
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        {harnesses.map((h) => (
          <div class="flex items-center gap-2.5 rounded-full border border-white/8 bg-brand-900/60 px-4 py-2">
            <img src={h.icon} alt={h.name} class="h-5 w-5 object-contain" />
            <span class="text-sm font-medium text-slate-300">{h.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="border-b border-white/5 px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="mb-16 text-center">
        <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">
          One control surface for everything you do with AI harnesses
        </h2>
        <p class="mx-auto max-w-xl text-slate-400">
          From a single richly-referenced prompt to a validated multi-step pipeline — one
          prompt language, one output view, one reusable toolkit underneath.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-xl border border-white/8 bg-brand-900/40 p-6 hover:border-sky-400/20 transition-colors">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-sky-400/10 font-mono text-sky-400">
              {f.icon}
            </div>
            <h3 class="mb-2 font-semibold text-white">{f.title}</h3>
            <p class="text-sm leading-relaxed text-slate-400">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="border-b border-white/5 bg-brand-900/20 px-6 py-24">
    <div class="mx-auto max-w-4xl">
      <div class="mb-16 text-center">
        <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">How it works</h2>
        <p class="text-slate-400">Prompt, steer, automate, and revisit — all from the same interface.</p>
      </div>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((s) => (
          <div class="relative flex flex-col items-start">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-full border border-sky-400/30 bg-sky-400/10 text-lg font-bold text-sky-400">
              {s.number}
            </div>
            <h3 class="mb-2 text-lg font-semibold text-white">{s.title}</h3>
            <p class="text-sm leading-relaxed text-slate-400">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pro callout -->
  <section class="border-b border-white/5 px-6 py-24">
    <div class="mx-auto max-w-4xl">
      <div class="overflow-hidden rounded-2xl border border-sky-400/15 bg-gradient-to-br from-brand-800 to-brand-900 p-10 md:p-14">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-sky-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-sky-400">
          ctrlyoke Pro
        </div>
        <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">Code from anywhere</h2>
        <p class="mb-8 max-w-xl text-lg text-slate-300">
          ctrlyoke Pro unlocks the remote dashboard — open your running workflows in any
          browser, on any device, from anywhere on your network. Start a long task, close
          your laptop, check in from your phone.
        </p>
        <div class="mb-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {[
            "Remote & LAN browser dashboard",
            "LAN IP binding & QR-to-phone access",
            "HTTPS with custom TLS certificates",
            "Push notifications (browser + mobile)",
            "Custom icon color",
            "Air-gapped offline activation",
            "14-day free trial — no card required",
          ].map((item) => (
            <div class="flex items-center gap-2.5 text-sm text-slate-300">
              <svg class="h-4 w-4 shrink-0 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
              {item}
            </div>
          ))}
        </div>
        <a
          href="/pricing/"
          class="inline-flex items-center gap-2 rounded-lg bg-sky-400 px-6 py-3 font-semibold text-brand-950 hover:bg-sky-300 transition-colors"
        >
          See pricing
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Install CTA -->
  <section class="px-6 py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">Get started free</h2>
      <p class="mb-10 text-slate-400">
        Free forever for individuals and small teams. Install in seconds from the VS Code Marketplace.
      </p>
      <div class="flex flex-col items-center gap-4">
        <Cta
          href={MARKETPLACE_URL}
          class="inline-flex items-center gap-2 rounded-lg bg-sky-400 px-8 py-3.5 font-semibold text-brand-950 hover:bg-sky-300 transition-colors"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.583.063a1.5 1.5 0 0 0-1.032.392L7.963 7.489 3.195 3.868a1 1 0 0 0-1.276.038L.32 5.256a1 1 0 0 0-.009 1.493L3.735 10 .311 13.251a1 1 0 0 0 .009 1.493l1.6 1.35a1 1 0 0 0 1.276.038l4.768-3.621 8.588 7.034c.307.254.692.39 1.094.392A1.5 1.5 0 0 0 19.1 19.44l2.401-11.304c.009-.04.014-.082.017-.123A1.5 1.5 0 0 0 20.069.473 1.5 1.5 0 0 0 17.583.063zm.38 3.304v13.266l-7.13-6.633 7.13-6.633z"/></svg>
          Install for VS Code
        </Cta>
        {
          LAUNCHED && (
            <>
              <div class="flex items-center gap-3 text-sm text-slate-500">
                <span>or install the CLI</span>
              </div>
              <div class="rounded-lg border border-white/8 bg-brand-900 px-6 py-3 font-mono text-sm text-slate-300">
                npm install -g ctrlyoke
              </div>
            </>
          )
        }
      </div>
    </div>
  </section>

</Layout>
