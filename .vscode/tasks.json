{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "group": "build",
      "presentation": {
        "panel": "dedicated",
        "reveal": "never"
      },
      "problemMatcher": ["$esbuild-watch"]
    },
    {
      "type": "npm",
      "script": "compile:prod",
      "group": "build",
      "presentation": {
        "panel": "dedicated",
        "reveal": "never"
      },
      "problemMatcher": ["$esbuild-watch"]
    },
    {
      "type": "npm",
      "script": "watch",
      "group": "build",
      "presentation": {
        "panel": "dedicated",
        "reveal": "never"
      },
      "problemMatcher": ["$esbuild-watch"],
      "isBackground": true
    },
    {
      // Wipes .vscode-dev-tempdir/ (workspace folder + --user-data-dir) so the
      // "onboarding" launch config always starts from an unconfigured folder
      // and an unseen walkthrough globalState flag, not leftover state from
      // the last test run. A script file (not inline `node -e`) because
      // VS Code's shell-task quoting mangles single quotes inside inline
      // `-e` code on PowerShell.
      "label": "reset-onboarding-tempdir",
      "type": "shell",
      "command": "node",
      "args": ["scripts/reset-dev-tempdir.mjs"],
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "compile (onboarding tempdir)",
      "dependsOn": ["reset-onboarding-tempdir", "npm: compile"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
