{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "group": "build",
      "presentation": {
        "panel": "dedicated",
        "reveal": "never"
      },
      "problemMatcher": ["$esbuild-watch"]
    },
    {
      "type": "npm",
      "script": "compile:prod",
      "group": "build",
      "presentation": {
        "panel": "dedicated",
        "reveal": "never"
      },
      "problemMatcher": ["$esbuild-watch"]
    },
    {
      "type": "npm",
      "script": "watch",
      "group": "build",
      "presentation": {
        "panel": "dedicated",
        "reveal": "never"
      },
      "problemMatcher": ["$esbuild-watch"],
      "isBackground": true
    },
    {
      // Wipes .vscode-dev-tempdir/ (workspace folder + --user-data-dir) so the
      // "onboarding" launch config always starts from an unconfigured folder
      // and an unseen walkthrough globalState flag, not leftover state from
      // the last test run.
      "label": "reset-onboarding-tempdir",
      "type": "shell",
      "command": "node",
      "args": [
        "-e",
        "const fs=require('fs');const p='${workspaceFolder}/.vscode-dev-tempdir';fs.rmSync(p,{recursive:true,force:true});fs.mkdirSync(p+'/workspace',{recursive:true});"
      ],
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "compile (onboarding tempdir)",
      "dependsOn": ["reset-onboarding-tempdir", "npm: compile"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
